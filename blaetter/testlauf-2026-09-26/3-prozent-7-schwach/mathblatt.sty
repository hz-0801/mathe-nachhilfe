% ---------------------------------------------------------------------------
% H  Baumdiagramm, Säulen-, Balken- und Liniendiagramm
% ---------------------------------------------------------------------------
% Zweistufig: \baumzwei{Stufe 1}{Stufe 2 nach 1. Ast}{Stufe 2 nach 2. Ast}
%   Listen als  Label/Wahrscheinlichkeit , leere Wahrscheinlichkeit = Feld zum Eintragen
%   \baumzwei{R/0.4,B/0.6}{R/0.4,B/0.6}{R/0.4,B/0.6}
%   \baumzwei{R/,B/}{R/,B/}{R/,B/}
\NewDocumentCommand{\baumzwei}{m m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.6pt,
     ast/.style={font=\small,inner sep=1.5pt}, wk/.style={font=\scriptsize,fill=white,inner sep=1pt}]
    \coordinate (S) at (0,0);
    \def\mbi{0}
    \foreach \l/\p [count=\i] in {#1}{%
      \pgfmathsetmacro{\yy}{2.2-2.2*\i+1.1}
      \node[ast] (E\i) at (2.4,\yy) {$\l$};
      \draw (S) -- (E\i) node[wk,pos=0.5] {\ifx\p\empty\underline{\hspace{5mm}}\else$\p$\fi};
      \ifnum\i=1 \foreach \m/\q [count=\j] in {#2}{%
         \pgfmathsetmacro{\zz}{\yy+0.55-1.1*(\j-1)}
         \draw (E\i) -- (4.8,\zz) node[wk,pos=0.5] {\ifx\q\empty\underline{\hspace{5mm}}\else$\q$\fi}
               node[ast,right] {$\m$};}\fi
      \ifnum\i=2 \foreach \m/\q [count=\j] in {#3}{%
         \pgfmathsetmacro{\zz}{\yy+0.55-1.1*(\j-1)}
         \draw (E\i) -- (4.8,\zz) node[wk,pos=0.5] {\ifx\q\empty\underline{\hspace{5mm}}\else$\q$\fi}
               node[ast,right] {$\m$};}\fi
    }
  \end{tikzpicture}}
% Säulendiagramm: \saeulen{Mo/12,Di/7,Mi/9}{ymax}{ystep}{Achsentitel}
%   Ohne Werte (Schüler zeichnet): \saeulen{Mo/,Di/,Mi/}{16}{4}{Anzahl}
\NewDocumentCommand{\saeulen}{m m m m}{%
  \def\mbcats{}\def\mbpaare{}\def\mbhat{0}%
  \foreach \k/\w in {#1}{%
    \ifx\mbcats\empty\xdef\mbcats{\k}\else\xdef\mbcats{\mbcats,\k}\fi
    \ifx\w\empty\xappto\mbpaare{(\k,0) }\else\xappto\mbpaare{(\k,\w) }\gdef\mbhat{1}\fi}%
  \begin{tikzpicture}[baseline=(current bounding box.north)]
  \begin{axis}[ybar,width=8cm,height=5.5cm,ymin=0,ymax=#2,ytick distance=#3,
    symbolic x coords/.expanded={\mbcats},xtick/.expanded={\mbcats},enlarge x limits=0.25,bar width=9mm,
    ylabel={#4},ylabel style={font=\small},tick label style={font=\small},
    ymajorgrids,grid style={mbgitter},axis line style={line width=0.6pt}]
    \ifnum\mbhat=1
      \addplot[fill=mbkasten,draw=black,nodes near coords,every node near coord/.append style={font=\scriptsize}]
        coordinates {\mbpaare};
    \else
      \addplot[draw=none,fill=none] coordinates {\mbpaare};
    \fi
  \end{axis}
  \end{tikzpicture}}

% Säulendiagramm zum Ablesen: Säulen OHNE Wertebeschriftung, mit feinen Hilfslinien zwischen den
% bezifferten Linien – Gegenstück zu \saeulen für Aufgaben, in denen der Wert vom Gitter abgelesen
% werden soll statt an der Säule zu stehen.
%   \saeulenab[ymax=100,ystep=20,yfein=5,ylabel=Anzahl]{Mo/45,Di/70}
%   Leere Werte -> nur Achse und Gitter (Schüler zeichnet). Schlüssel: ymin (0), ymax, ystep, yfein
%   (Feingitter), ylabel, hoehe (Säulenhöhe max., 5 cm), breite (Säulenbreite, 1.5 cm), ohnezahlen
%   (unterdrückt die y-Achsenzahlen, für Aufgaben zur Achseneinteilung).
%   breite ist ein Mindestmaß: Das Makro misst die Kategorienamen und rückt die Säulen so weit
%   auseinander, dass der breiteste mit Lücke danebenpasst. Kurze Namen ändern daran nichts.
%   Reicht der Satzspiegel dafür nicht, bleibt es bei der größten Breite, die noch hineinpasst,
%   und die Namen werden zusätzlich auf mehrere Zeilen umbrochen.
\pgfkeys{/sab/.is family, /sab,
  ymax/.estore in=\sabymax, ystep/.estore in=\sabystep, yfein/.estore in=\sabyfein,
  ylabel/.estore in=\sabylabel, hoehe/.estore in=\sabhoehe, breite/.estore in=\sabbreite,
  ohnezahlen/.is if=mbsabohne, ymin/.estore in=\sabymin,
  default/.style={ymin=0,ymax=10,ystep=2,yfein=1,ylabel=Anzahl,hoehe=5,breite=1.5}}
\newif\ifmbsabohne
\newsavebox{\mbsabbox}
\NewDocumentCommand{\saeulenab}{O{} m}{%
  \mbsabohnefalse\pgfkeys{/sab,default,#1}%
  \pgfmathsetmacro{\sabsk}{\sabhoehe/(\sabymax-\sabymin)}%
  \pgfmathsetmacro{\sabya}{\sabymin+\sabyfein}%
  \pgfmathsetmacro{\sabyb}{\sabymin+\sabystep}%
  \def\sabn{0}%
  \foreach \k/\w [count=\i] in {#2}{\xdef\sabn{\i}}%
  \pgfmathsetmacro{\sabr}{\sabn+0.7}%
  \pgfmathsetmacro{\sabo}{\sabymax+0.9*\sabystep}%
  % Kategorienamen messen und die Säulen danach auseinanderrücken (Mindestmaß bleibt breite),
  % gedeckelt durch den Satzspiegel; bindet der Deckel, werden die Namen umbrochen.
  \xdef\mbsabwmax{0pt}%
  \foreach \k/\w in {#2}{\sbox{\mbsabbox}{\small\k}%
    \ifdim\wd\mbsabbox>\mbsabwmax\xdef\mbsabwmax{\the\wd\mbsabbox}\fi}%
  \pgfmathsetmacro{\mbsabnoetig}{(\mbsabwmax+4)/28.4528}%
  \pgfmathsetmacro{\mbsabdeckel}{max(\sabbreite,(\linewidth/28.4528-1.6)/(\sabn+0.7))}%
  \pgfmathsetmacro{\mbsabbr}{min(max(\sabbreite,\mbsabnoetig),\mbsabdeckel)}%
  \pgfmathtruncatemacro{\mbsabum}{\mbsabnoetig>\mbsabbr}%
  \pgfmathsetmacro{\mbsabtw}{\mbsabbr-0.35}%
  \begin{tikzpicture}[x=\mbsabbr cm,y=\sabsk cm,baseline=(current bounding box.north),line width=0.6pt]
    \foreach \y in {\sabymin,\sabya,...,\sabymax}{\draw[mbgitter,line width=0.3pt] (0,\y) -- (\sabr,\y);}
    \foreach \y in {\sabymin,\sabyb,...,\sabymax}{%
      \draw[black!45,line width=0.3pt] (0,\y) -- (\sabr,\y);
      \ifmbsabohne\else\node[left,font=\small,inner sep=3pt] at (0,\y) {\pgfmathprintnumber{\y}};\fi}
    \foreach \k/\w [count=\i] in {#2}{%
      \ifx\w\empty\else\filldraw[fill=mbkasten,draw=black,line width=0.7pt]
        (\i-0.3,\sabymin) rectangle (\i+0.3,\w);\fi%
      \ifnum\mbsabum=1
        \node[below,font=\small,inner sep=4pt,align=center,text width=\mbsabtw cm] at (\i,\sabymin) {\k};
      \else
        \node[below,font=\small,inner sep=4pt] at (\i,\sabymin) {\k};
      \fi}
    \draw[-{Stealth[length=2mm]}] (0,\sabymin) -- (0,\sabo) node[above right,font=\small,inner sep=2pt] {\sabylabel};
    \draw[-{Stealth[length=2mm]}] (0,\sabymin) -- (\sabr,\sabymin);
  \end{tikzpicture}}

% Balkendiagramm (waagerecht), ohne Wertebeschriftung – Gegenstück zu \saeulenab mit vertauschten Achsen.
%   \balkenab[xmax=50,xstep=10,xfein=2,xlabel=Anzahl]{Rot/32,Blau/18}
%   Schlüssel: xmax (10), xstep, xfein, xlabel, breite (Balkenlänge max., 8 cm), hoehe (Balkenhöhe, 1.1 cm)
%   breite ist ein Höchstmaß: Das Makro misst die Kategorienamen links an der Achse und den
%   Achsentitel rechts, hält den Platz dafür frei und kürzt die Balken so weit, dass alles zusammen
%   in den Satzspiegel passt. Kurze Namen ändern daran nichts. Bräuchte der breiteste Name mehr als
%   die für die Namen vorgesehene Spalte (45 % des Satzspiegels), wird er umbrochen; die Zeilenhöhe
%   wächst dann mit, damit die Namen nicht aneinanderstoßen. Das \hspace{0pt} vor dem Namen erlaubt
%   TeX, dabei auch ein einzelnes langes Wort zu trennen (sonst bleibt das erste Wort ungetrennt).
\pgfkeys{/bab/.is family, /bab,
  xmax/.estore in=\babxmax, xstep/.estore in=\babxstep, xfein/.estore in=\babxfein,
  xlabel/.estore in=\babxlabel, breite/.estore in=\babbreite, hoehe/.estore in=\babhoehe,
  default/.style={xmax=10,xstep=2,xfein=1,xlabel=Anzahl,breite=8,hoehe=1.1}}
\NewDocumentCommand{\balkenab}{O{} m}{%
  \pgfkeys{/bab,default,#1}%
  \def\babn{0}%
  \foreach \k/\w [count=\i] in {#2}{\xdef\babn{\i}}%
  \pgfmathsetmacro{\babo}{\babn+0.7}%
  \pgfmathsetmacro{\babr}{\babxmax+0.9*\babxstep}%
  % Kategorienamen (links) und Achsentitel (rechts) messen: Der Platz links richtet sich nach dem
  % längsten Namen, der Rest des Satzspiegels bleibt für Balken, Gitter und Achsentitel.
  \xdef\mbbabwmax{0pt}%
  \foreach \k/\w in {#2}{\sbox{\mbsabbox}{\small\k}%
    \ifdim\wd\mbsabbox>\mbbabwmax\xdef\mbbabwmax{\the\wd\mbsabbox}\fi}%
  \sbox{\mbsabbox}{\small\babxlabel}\xdef\mbbabwtitel{\the\wd\mbsabbox}%
  \pgfmathsetmacro{\mbbablw}{\linewidth/28.4528}%
  \pgfmathsetmacro{\mbbabnoetig}{(\mbbabwmax+9)/28.4528}%
  \pgfmathsetmacro{\mbbabdeckel}{max(1.2,0.45*\mbbablw)}%
  \pgfmathsetmacro{\mbbabplatz}{min(\mbbabnoetig,\mbbabdeckel)}%
  \pgfmathtruncatemacro{\mbbabum}{\mbbabnoetig>\mbbabplatz}%
  \pgfmathsetmacro{\mbbabtw}{\mbbabplatz-0.32}%
  \pgfmathsetmacro{\mbbabzeilen}{max(1,ceil(\mbbabnoetig/\mbbabplatz))}%
  \pgfmathsetmacro{\mbbabho}{max(\babhoehe,0.48*\mbbabzeilen+0.25)}%
  \pgfmathsetmacro{\mbbabrand}{(\mbbabwtitel+6)/28.4528}%
  \pgfmathsetmacro{\mbbabfrei}{max(0.35*\mbbablw,\mbbablw-\mbbabplatz-\mbbabrand)}%
  \pgfmathsetmacro{\babsk}{min(\babbreite/\babxmax,\mbbabfrei/\babr)}%
  \begin{tikzpicture}[x=\babsk cm,y=\mbbabho cm,baseline=(current bounding box.north),line width=0.6pt]
    \foreach \x in {0,\babxfein,...,\babxmax}{\draw[mbgitter,line width=0.3pt] (\x,0) -- (\x,\babo);}
    \foreach \x in {0,\babxstep,...,\babxmax}{%
      \draw[black!45,line width=0.3pt] (\x,0) -- (\x,\babo);
      \node[below,font=\small,inner sep=3pt] at (\x,0) {\pgfmathprintnumber{\x}};}
    \foreach \k/\w [count=\i] in {#2}{%
      \ifx\w\empty\else\filldraw[fill=mbkasten,draw=black,line width=0.7pt]
        (0,\i-0.3) rectangle (\w,\i+0.3);\fi%
      \ifnum\mbbabum=1
        \node[left,font=\small,inner sep=4pt,align=flush right,text width=\mbbabtw cm] at (0,\i) {\hspace{0pt}\k};
      \else
        \node[left,font=\small,inner sep=4pt] at (0,\i) {\k};
      \fi}
    \draw[-{Stealth[length=2mm]}] (0,0) -- (\babr,0) node[below right,font=\small,inner sep=2pt] {\babxlabel};
    \draw[-{Stealth[length=2mm]}] (0,0) -- (0,\babo);
  \end{tikzpicture}}

% Liniendiagramm über Kategorien, ohne Wertebeschriftung; nutzt dieselben Schlüssel wie \saeulenab
% (ymax, ystep, yfein, ylabel, hoehe, breite je Kategorie), \sabymin bleibt dabei 0.
%   \liniendia[ymax=20,ystep=5,yfein=1,ylabel=Temperatur]{2019/12,2020/15,...}
%   breite ist – wie bei \saeulenab – ein Mindestmaß: Das Makro misst die Kategorienamen unter der
%   Achse und rückt die Punkte so weit auseinander, dass der breiteste Name mit Lücke danebenpasst.
%   Reicht der Satzspiegel dafür nicht, bleibt es bei der größten Breite, die noch hineinpasst, und
%   die Namen werden zusätzlich umbrochen. Kurze Namen ändern daran nichts. Das \hspace{0pt} vor dem
%   Namen erlaubt TeX, dabei auch ein einzelnes langes Wort zu trennen.
\NewDocumentCommand{\liniendia}{O{} m}{%
  \mbsabohnefalse\pgfkeys{/sab,default,#1}%
  \pgfmathsetmacro{\sabsk}{\sabhoehe/\sabymax}%
  \def\sabn{0}%
  \foreach \k/\w [count=\i] in {#2}{\xdef\sabn{\i}}%
  \pgfmathsetmacro{\sabr}{\sabn+0.7}%
  \pgfmathsetmacro{\sabo}{\sabymax+0.9*\sabystep}%
  % Kategorienamen messen und die Punkte danach auseinanderrücken (Mindestmaß bleibt breite),
  % gedeckelt durch den Satzspiegel; bindet der Deckel, werden die Namen umbrochen.
  \xdef\mblinwmax{0pt}%
  \foreach \k/\w in {#2}{\sbox{\mbsabbox}{\small\k}%
    \ifdim\wd\mbsabbox>\mblinwmax\xdef\mblinwmax{\the\wd\mbsabbox}\fi}%
  \pgfmathsetmacro{\mblinnoetig}{(\mblinwmax+4)/28.4528}%
  \pgfmathsetmacro{\mblindeckel}{max(\sabbreite,(\linewidth/28.4528-1.6)/(\sabn+0.7))}%
  \pgfmathsetmacro{\mblinbr}{min(max(\sabbreite,\mblinnoetig),\mblindeckel)}%
  \pgfmathtruncatemacro{\mblinum}{\mblinnoetig>\mblinbr}%
  \pgfmathsetmacro{\mblintw}{\mblinbr-0.35}%
  \begin{tikzpicture}[x=\mblinbr cm,y=\sabsk cm,baseline=(current bounding box.north),line width=0.6pt]
    \foreach \y in {0,\sabyfein,...,\sabymax}{\draw[mbgitter,line width=0.3pt] (0,\y) -- (\sabr,\y);}
    \foreach \y in {0,\sabystep,...,\sabymax}{%
      \draw[black!45,line width=0.3pt] (0,\y) -- (\sabr,\y);
      \node[left,font=\small,inner sep=3pt] at (0,\y) {\pgfmathprintnumber{\y}};}
    \foreach \k/\w [count=\i] in {#2}{%
      \draw[mbgitter,line width=0.3pt] (\i,0) -- (\i,\sabymax);
      \ifnum\mblinum=1
        \node[below,font=\small,inner sep=4pt,align=center,text width=\mblintw cm] at (\i,0) {\hspace{0pt}\k};
      \else
        \node[below,font=\small,inner sep=4pt] at (\i,0) {\k};
      \fi}
    \xdef\mblinpath{}%
    \foreach \k/\w [count=\i] in {#2}{%
      \ifnum\i=1\xdef\mblinpath{(\i,\w)}\else\xdef\mblinpath{\mblinpath -- (\i,\w)}\fi}%
    \draw[line width=0.9pt] \mblinpath;
    \foreach \k/\w [count=\i] in {#2}{\fill (\i,\w) circle (1.8pt);}
    \draw[-{Stealth[length=2mm]}] (0,0) -- (0,\sabo) node[above right,font=\small,inner sep=2pt] {\sabylabel};
    \draw[-{Stealth[length=2mm]}] (0,0) -- (\sabr,0);
  \end{tikzpicture}}

% ---------------------------------------------------------------------------
% J  Boxplot und Histogramm
% ---------------------------------------------------------------------------
% Boxplots mit gemeinsamer Achse, von unten nach oben; Gitter zum Selbstzeichnen.
% \begin{boxplots}[xmin=0,xmax=20,xstep=2,xlabel=Punkte]
%   \bp{4,7,9,13,18}{A}      Minimum, unteres Quartil, Median, oberes Quartil, Maximum
%                            Label im Textmodus (Klasse 8a); Werte ausserhalb xmin..xmax -> Warnung
%   \bp{}{B}                 leere Zeile: Schüler zeichnet selbst
% \end{boxplots}
% karo = Kantenlänge einer Gitterzelle in cm (Voreinstellung 0.5); der Maßstab
% ergibt sich wie beim ksys aus karo und xstep.
\pgfkeys{/bpl/.is family, /bpl,
  xmin/.estore in=\bpxmin, xmax/.estore in=\bpxmax, xstep/.estore in=\bpxstep,
  karo/.estore in=\bpkaro, xlabel/.estore in=\bpxlabel,
  default/.style={xmin=0,xmax=20,xstep=2,karo=0.5,xlabel=$x$}}
\newcounter{mbbp}
\newenvironment{boxplots}[1][]{%
  \pgfkeys{/bpl,default,#1}%
  \setcounter{mbbp}{0}%
  \pgfmathsetmacro{\bpk}{\bpkaro/\bpxstep}%
  \pgfmathsetmacro{\bptx}{0.12*\bpxstep}%
  \pgfmathsetmacro{\bppfeil}{\bpxmax+0.6*\bpxstep}%
  \pgfmathsetmacro{\bpxa}{\bpxmin+\bpxstep}%
  \ifdim\bpkaro cm<0.6cm \def\mbtf{\tiny}\else\def\mbtf{\scriptsize}\fi
  \xdef\mbwmax{0pt}%
  \foreach \x in {\bpxmin,\bpxa,...,\bpxmax}{\sbox\mbmessbox{\mbtf$\pgfmathprintnumber{\x}$}%
    \ifdim\wd\mbmessbox>\mbwmax\xdef\mbwmax{\the\wd\mbmessbox}\fi}%
  \pgfmathtruncatemacro{\bpl}{max(1,ceil((\mbwmax+2pt)/(\bpkaro cm)))}%
  \begin{tikzpicture}[x=\bpk cm,y=1cm,baseline=(current bounding box.north)]
}{%
  \pgfmathsetmacro{\bphoehe}{1.2*\value{mbbp}+0.2}%
  \draw[mbgitter,line width=0.3pt] (\bpxmin,0) grid[xstep=\bpxstep,ystep=\bpkaro] (\bpxmax,\bphoehe);
  \draw[-{Stealth[length=2mm]},line width=0.6pt] (\bpxmin,0) -- (\bppfeil,0) node[right] {\small\bpxlabel};
  \foreach \x in {\bpxmin,\bpxa,...,\bpxmax}{%
    \pgfmathtruncatemacro{\mbrest}{mod(abs(round(\x/\bpxstep)),\bpl)}%
    \draw (\x,0.12) -- (\x,-0.12)
      \ifnum\mbrest=0 node[below,inner sep=1.5pt] {\mbtf$\pgfmathprintnumber{\x}$}\fi;}
  \end{tikzpicture}}
\def\mbbpfuenf#1,#2,#3,#4,#5\relax{\def\bpa{#1}\def\bpb{#2}\def\bpc{#3}\def\bpd{#4}\def\bpe{#5}}
\NewDocumentCommand{\bp}{m m}{%
  \stepcounter{mbbp}%
  \pgfmathsetmacro{\bpy}{1.2*\value{mbbp}-0.6}%
  \node[left,font=\small,inner sep=4pt] at (\bpxmin,\bpy) {#2};
  \ifblank{#1}{}{%
    \mbbpfuenf#1\relax
    \pgfmathparse{(\bpa<\bpxmin)||(\bpe>\bpxmax)}\ifdim\pgfmathresult pt>0pt
      \PackageWarning{mathblatt}{bp: Werte liegen ausserhalb von xmin..xmax}\fi
    \pgfmathsetmacro{\bpu}{\bpy-0.35}\pgfmathsetmacro{\bpo}{\bpy+0.35}%
    \draw[line width=0.7pt] (\bpa,\bpu) -- (\bpa,\bpo) (\bpe,\bpu) -- (\bpe,\bpo);
    \draw[line width=0.7pt] (\bpa,\bpy) -- (\bpb,\bpy) (\bpd,\bpy) -- (\bpe,\bpy);
    \filldraw[fill=mbkasten,line width=0.7pt] (\bpb,\bpu) rectangle (\bpd,\bpo);
    \draw[line width=1pt] (\bpc,\bpu) -- (\bpc,\bpo);}}
% Histogramm: Klassen als  von:bis/Höhe , durch Komma getrennt.
% \histogramm{0:10/4, 10:20/9, 20:40/6}                 Höhe = Häufigkeit
% \histogramm[dichte]{0:10/4, 10:20/9, 20:40/6}         Höhe = Häufigkeit / Klassenbreite
% \histogramm{0:10/, 10:20/, 20:40/}                    nur Achsen und Klassengrenzen
% Schlüssel: ymax, ystep, karo, xlabel, ylabel, dichte, titel (Textmodus, über dem Diagramm)
\pgfkeys{/hst/.is family, /hst,
  ymax/.estore in=\hsymax, ystep/.estore in=\hsystep, xstep/.estore in=\hsxstep,
  karo/.estore in=\hskaro, xlabel/.estore in=\hsxlabel, ylabel/.estore in=\hsylabel,
  dichte/.is if=mbhsdichte, titel/.estore in=\hstitel,
  default/.style={ymax=10,ystep=1,xstep=10,karo=0.5,xlabel=$x$,ylabel=$h$,titel=}}
\newif\ifmbhsdichte
\NewDocumentCommand{\histogramm}{O{} m}{%
  \mbhsdichtefalse\pgfkeys{/hst,default,#1}%
  \def\hsxa{}\def\hsxb{}%
  \foreach \k/\h in {#2}{\expandafter\mbrzwei\k\relax
    \ifx\hsxa\empty\xdef\hsxa{\mbrtmin}\fi\xdef\hsxb{\mbrtmax}}%
  \pgfmathsetmacro{\hsxk}{\hskaro/\hsxstep}%
  \pgfmathsetmacro{\hsyk}{\hskaro/\hsystep}%
  \pgfmathsetmacro{\hsxpfeil}{\hsxb+0.6*\hsxstep}%
  \pgfmathsetmacro{\hsypfeil}{\hsymax+0.6*\hsystep}%
  \ifdim\hskaro cm<0.6cm \def\mbtf{\tiny}\else\def\mbtf{\scriptsize}\fi
  \begin{tikzpicture}[x=\hsxk cm,y=\hsyk cm,baseline=(current bounding box.north)]
    \draw[mbgitter,line width=0.3pt] (\hsxa,0) grid[xstep=\hsxstep,ystep=\hsystep] (\hsxb,\hsymax);
    \foreach \k/\h in {#2}{\expandafter\mbrzwei\k\relax
      \ifx\h\empty\else
        \ifmbhsdichte\pgfmathsetmacro{\hsh}{(\h)/(\mbrtmax-\mbrtmin)}\else\pgfmathsetmacro{\hsh}{\h}\fi
        \filldraw[fill=mbkasten,line width=0.7pt] (\mbrtmin,0) rectangle (\mbrtmax,\hsh);
      \fi}%
    \draw[-{Stealth[length=2mm]},line width=0.6pt] (\hsxa,0) -- (\hsxpfeil,0) node[right] {\small\hsxlabel};
    \draw[-{Stealth[length=2mm]},line width=0.6pt] (\hsxa,0) -- (\hsxa,\hsypfeil) node[above] {\small\hsylabel};
    \ifdefempty{\hstitel}{}{\pgfmathsetmacro{\hsty}{\hsypfeil+0.45/\hsyk}%
      \node[above,font=\small\bfseries,inner sep=2pt] at ({(\hsxa+\hsxb)/2},\hsty) {\hstitel};}
    \foreach \k/\h [count=\i] in {#2}{\expandafter\mbrzwei\k\relax
      \ifnum\i=1 \draw (\mbrtmin,{0.12*\hsystep}) -- (\mbrtmin,{-0.12*\hsystep})
        node[below,inner sep=1.5pt] {\mbtf$\pgfmathprintnumber{\mbrtmin}$};\fi
      \draw (\mbrtmax,{0.12*\hsystep}) -- (\mbrtmax,{-0.12*\hsystep})
        node[below,inner sep=1.5pt] {\mbtf$\pgfmathprintnumber{\mbrtmax}$};}%
    \pgfmathsetmacro{\hsya}{\hsystep}\pgfmathsetmacro{\hsyb}{2*\hsystep}%
    \foreach \y in {\hsya,\hsyb,...,\hsymax}{\ifdim \y pt=0pt\else
      \draw (\hsxa,\y) ++({0.12*\hsxstep},0) -- ++({-0.24*\hsxstep},0)
        node[left,inner sep=1.5pt] {\mbtf$\pgfmathprintnumber{\y}$};\fi}
  \end{tikzpicture}}

% ---------------------------------------------------------------------------
% K  Kreis und Winkelfiguren (Maße in cm, Winkel in Grad, 0 Grad = rechts)
% ---------------------------------------------------------------------------
% Ein Kreis mit Zusätzen: Umgebung kreis, Radius in cm.
% \begin{kreis}[2]                          Radius 2 cm (Voreinstellung 2)
%   \mittelpunkt{M}                         Punkt und Label in der Mitte
%   \radius{40}{r}                          Radius zum Randpunkt bei 40 Grad
%   \durchmesser{0}{d}                      Durchmesser durch den Mittelpunkt
%   \sehne{200}{340}{s}                     Sehne zwischen zwei Randpunkten
%   \tangente{300}{t}                       Tangente im Randpunkt, Beruehrpunkt markiert
%   \sektor{30}{110}{\alpha}                grau gefuellter Sektor, Winkel beschriftet
%   \bogen{30}{110}{b}                      nur der Bogen, dicker gezeichnet
%   \kreispunkt{110}{B}                     Punkt auf dem Rand mit Label
% \end{kreis}
% Winkel werden gegen den Uhrzeigersinn gezaehlt; leeres Label {} laesst es weg.
\pgfkeys{/krs/.is family, /krs, r/.estore in=\krr, default/.style={r=2}}
\newenvironment{kreis}[1][2]{%
  \pgfkeys{/krs,default,r=#1}%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.7pt]
    \draw (0,0) circle (\krr);
}{\end{tikzpicture}}
% \mblabel{Text}{Position}{Optionen} – setzt nichts, wenn der Text leer ist
\newcommand{\mbklabel}[3]{\ifblank{#1}{}{\node[#3,font=\small] at #2 {$#1$};}}
\newcommand{\mittelpunkt}[1]{\fill (0,0) circle (1.6pt);
  \mbklabel{#1}{(0,0)}{below left,inner sep=3pt}}
\NewDocumentCommand{\kreispunkt}{O{} m m}{%
  \fill (#2:\krr) circle (1.6pt);
  \mbklabel{#3}{({#2}:{\krr+0.3})}{#1}}
\newcommand{\radius}[2]{%
  \draw[line width=0.7pt] (0,0) -- (#1:\krr);
  \mbklabel{#2}{($({#1}:{0.55*\krr})+({#1-90}:0.22)$)}{inner sep=1pt}}
\newcommand{\durchmesser}[2]{%
  \draw[line width=0.7pt] ({#1+180}:\krr) -- (#1:\krr);
  \mbklabel{#2}{($({#1}:{0.6*\krr})+({#1+90}:0.22)$)}{inner sep=1pt}}
\newcommand{\sehne}[3]{%
  \draw[line width=0.7pt] (#1:\krr) -- (#2:\krr);
  \mbklabel{#3}{($0.5*(#1:\krr)+0.5*(#2:\krr)+({(#1+#2)/2}:0.22)$)}{inner sep=1pt}}
% Tangente: Beruehrpunkt bei #1, rechter Winkel zum Radius markiert
\newcommand{\tangente}[2]{%
  \pgfmathsetmacro{\krl}{0.85*\krr}%
  \draw[dashed,line width=0.5pt] (0,0) -- (#1:\krr);
  \draw[line width=0.7pt] ($(#1:\krr)+({#1+90}:\krl)$) -- ($(#1:\krr)+({#1-90}:\krl)$);
  \draw[line width=0.4pt] ($(#1:\krr)+({#1+90}:0.22)$) -- ($(#1:\krr)+({#1+90}:0.22)+({#1+180}:0.22)$)
    -- ($(#1:\krr)+({#1+180}:0.22)$);
  \fill (#1:\krr) circle (1.4pt);
  \mbklabel{#2}{($(#1:\krr)+({#1-90}:{0.75*\krl})$)}{fill=white,inner sep=1pt}}
\newcommand{\sektor}[3]{%
  \filldraw[fill=mbgrau,fill opacity=0.15,line width=0.7pt]
    (0,0) -- (#1:\krr) arc (#1:#2:\krr) -- cycle;
  \pgfmathsetmacro{\krm}{(#1+#2)/2}%
  \mbklabel{#3}{(\krm:{0.45*\krr})}{}}
\newcommand{\bogen}[3]{%
  \draw[line width=1.1pt] (#1:\krr) arc (#1:#2:\krr);
  \pgfmathsetmacro{\krm}{(#1+#2)/2}%
  \mbklabel{#3}{(\krm:{\krr+0.32})}{}}
% Winkelfiguren
% \geradenkreuzung{35}{\alpha}{\beta}{\gamma}{\delta}  zwei Geraden durch einen Punkt;
%   alpha rechts oben, beta links oben, gamma links unten (Scheitel zu alpha), delta rechts unten
% \parallelenpaar{60}{\alpha}{\beta}{\gamma}{\delta}   zwei Parallelen mit Schnittgerade;
%   alpha, beta an der oberen Kreuzung (rechts oben, links oben), gamma, delta an der unteren
% \winkel[4]{40}{\alpha}   ein Winkel, Schenkellaenge 4 cm (Voreinstellung 3)
% \winkelstrahl            Strahl zum Antragen eines Winkels: Scheitel links (Vorgabe S),
%   waagerecht nach rechts, Laenge 7 cm; darueber bleiben 4 cm frei fuer den zweiten Schenkel.
% \winkelstrahl[9]         andere Laenge in cm
% \winkelstrahl[7][A]      anderer Name des Scheitels
\NewDocumentCommand{\geradenkreuzung}{m m m m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.7pt]
    \draw (180:2.4) -- (0:2.4);
    \draw ({#1+180}:2.4) -- (#1:2.4);
    \draw[mbgrau,line width=0.5pt] (0.75,0) arc (0:#1:0.75);
    \pgfmathsetmacro{\wka}{#1/2}\pgfmathsetmacro{\wkb}{(#1+180)/2}%
    \mbklabel{#2}{(\wka:1.1)}{}\mbklabel{#3}{(\wkb:1.1)}{}%
    \mbklabel{#4}{({\wka+180}:1.1)}{}\mbklabel{#5}{({\wkb+180}:1.1)}{}%
    \fill (0,0) circle (1.4pt);
  \end{tikzpicture}}
\NewDocumentCommand{\parallelenpaar}{m m m m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.7pt]
    \pgfmathsetmacro{\wpdx}{2.2*cos(#1)/sin(#1)}% cot statt 1/tan wegen #1 = 90
    \pgfmathsetmacro{\wpl}{min(\wpdx,0)-1.5}\pgfmathsetmacro{\wpr}{max(\wpdx,0)+1.5}%
    \coordinate (Q) at (0,0); \coordinate (P) at (\wpdx,2.2);
    \draw (\wpl,0) -- (\wpr,0); \draw (\wpl,2.2) -- (\wpr,2.2);
    \draw ($(Q)+({#1+180}:1.1)$) -- ($(P)+({#1}:1.1)$);
    \foreach \s in {P,Q}{%
      \draw[mbgrau,line width=0.5pt] ($(\s)+(0.7,0)$) arc (0:#1:0.7);
      \draw[mbgrau,line width=0.5pt] ($(\s)+({#1}:0.7)$) arc (#1:180:0.7);
      \fill (\s) circle (1.4pt);}%
    \pgfmathsetmacro{\wpa}{#1/2}\pgfmathsetmacro{\wpb}{(#1+180)/2}%
    \mbklabel{#2}{($(P)+({\wpa}:1.05)$)}{}\mbklabel{#3}{($(P)+({\wpb}:1.05)$)}{}%
    \mbklabel{#4}{($(Q)+({\wpa}:1.05)$)}{}\mbklabel{#5}{($(Q)+({\wpb}:1.05)$)}{}%
  \end{tikzpicture}}
\NewDocumentCommand{\winkel}{O{3} m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.7pt]
    \draw (0:#1) -- (0,0) -- (#2:#1);
    \draw[mbgrau,line width=0.5pt] (0.7,0) arc (0:#2:0.7);
    \pgfmathsetmacro{\wka}{#2/2}%
    \mbklabel{#3}{(\wka:1.1)}{}%
    \fill (0,0) circle (1.4pt);
  \end{tikzpicture}}
% Der Platz ueber dem Strahl steckt in der Bounding Box, deshalb haelt der Umbruch ihn frei;
% die Grundlinie liegt auf dem Strahl, das Scheitellabel darunter.
\NewDocumentCommand{\winkelstrahl}{O{7} O{S}}{%
  \par\addvspace{6pt}\noindent
  \begin{tikzpicture}[baseline=0pt,line width=0.7pt]
    \useasboundingbox (-0.4,-0.7) rectangle ({#1+0.6},4);
    \draw[-{Stealth[length=2.2mm]}] (0,0) -- (#1,0);
    \fill (0,0) circle (1.7pt);
    \node[below left,font=\small,inner sep=2pt] at (0,0) {$#2$};
  \end{tikzpicture}\par\addvspace{6pt}}

% ---------------------------------------------------------------------------
% I  Koordinatensystem 3D (Kavalierprojektion nach Unterrichtsblatt-Prompt §4.5)
% ---------------------------------------------------------------------------
% x2 waagerecht, x3 senkrecht, x1 unter 45° nach links unten, halbiert.
% Bildpunkt von (x1|x2|x3): (x2 - x1/2 | x3 - x1/2). 1 Einheit = 2 Karos.
% \begin{ksys3}                                        Oberstufe, Achsen x_1,x_2,x_3, Karo 5 mm
% \begin{ksys3}[x1min=-2,x1max=6,x2min=-3,x2max=6,x3min=-2,x3max=5]   (= Voreinstellung)
% \begin{ksys3}[xyz]                                   Sek I: Achsen x,y,z
% \begin{ksys3}[...,karo=0.4]                          Karo = Kantenlänge einer Gitterzelle in cm
% \begin{ksys3}[...,x1schritt=2]                       x1 nur bei 2, 4, 6 beziffert (bei engem System)
% \begin{ksys3}[leit]                                  Leitgrafik im Übersichtskasten: Karo 4 mm, 0..2
%   \rpunkt{4}{4}{3}{A}               Punkt mit Lot: entlang x1, dann parallel x2, dann parallel x3
%   \rpunkt[below right]{4}{4}{3}{A}  Labelposition wie bei TikZ-Knoten (Voreinstellung above right)
%   \rpunkt*{1}{1.5}{1.5}{S}          Punkt ohne Lot (Durchstoß-, Schnitt-, Spurpunkt)
%   \rvektor{2,4,3}{\vec a}                Ortsvektor vom Ursprung, Label in Pfeilmitte
%   \rvektorab[below]{1,1,0}{4,5,2}{\vec u}  Pfeil von A nach B (erstes Argument: Labelposition)
%   \rgerade{0,-2,1}{1,1,0.5}{g}           Stützpunkt, Richtungsvektor; läuft bis zum Rand des Achsenquaders
%   \rgerade[-1:1.5]{3,1,-1}{0,1,2}{h}     Parameterbereich t = -1..1,5 statt Rand; Label am Ende (t max)
%   \rebene{4}{6}{3}{E}                    Spurdreieck aus den Achsenabschnitten (x1|x2|x3)
%   \rebenepar{1,1,1}{2,1,0}{0,2,2}{F}     Parallelogramm: Stützpunkt, zwei Spannvektoren (als Pfeile)
%   \rebenepar*{0,0,3}{4,0,1}{0,5,0}{D}    Sternform: Fläche ohne Spannvektorpfeile (Dach, Wand)
%   \rquader{1,1,0}{3}{4}{2}               Quader: Ecke mit kleinsten Koordinaten, Kanten a (x1), b (x2), c (x3)
%   \rpyramide{0,1,0}{4}{3}{2,2.5,5}       Rechteckpyramide: Ecke, Kanten a (x1), b (x2), Spitze
% \end{ksys3}
% Körper im ksys3 tragen keine Labels; Eckpunkte setzt der Nutzer mit \rpunkt*.
% Verdeckte Kanten sind gestrichelt (Betrachter in Richtung (2|1|1)).
% Punkte und Vektoren der Vektor-, Geraden- und Ebenenmakros stehen als Tripel
% {x1,x2,x3} in einem Argument (LaTeX erlaubt höchstens 9 Argumente). \rpunkt und
% \rebene behalten getrennte Argumente.
% Das 5-mm-Gitter wird am Ende hinter die ganze gezeichnete Fläche gelegt; Punkte
% außerhalb der Achsbereiche liegen trotzdem auf Karo, die Achsen enden dann aber vor
% ihnen. Nicht mit den Körpern aus Abschnitt F auf einem Blatt kombinieren, die haben
% eine andere Blickrichtung (Tiefe nach rechts oben).
\pgfdeclarelayer{mbhinten}
\pgfkeys{/ksys3/.is family, /ksys3,
  x1min/.estore in=\ksamin, x1max/.estore in=\ksamax,
  x2min/.estore in=\ksbmin, x2max/.estore in=\ksbmax,
  x3min/.estore in=\kscmin, x3max/.estore in=\kscmax,
  karo/.estore in=\ksdkaro, x1schritt/.estore in=\ksaschritt,
  x1name/.estore in=\ksaname, x2name/.estore in=\ksbname, x3name/.estore in=\kscname,
  xyz/.style={x1name=x,x2name=y,x3name=z},
  leit/.style={karo=0.4,x1min=0,x1max=2,x2min=0,x2max=2,x3min=0,x3max=2},
  default/.style={x1min=-2,x1max=6,x2min=-3,x2max=6,x3min=-2,x3max=5,karo=0.5,x1schritt=1,
                  x1name=x_1,x2name=x_2,x3name=x_3}}
% Gitter über die gesamte gezeichnete Fläche, auf Karo-Vielfache gerastert, ein Karo Rand
\newcommand{\mbdreigitter}{%
  \path (current bounding box.south west); \pgfgetlastxy{\mbbxa}{\mbbya}%
  \path (current bounding box.north east); \pgfgetlastxy{\mbbxb}{\mbbyb}%
  \pgfmathsetlengthmacro{\mbgxa}{(floor(\mbbxa/(\ksdkaro cm)+0.001)-1)*\ksdkaro cm}%
  \pgfmathsetlengthmacro{\mbgya}{(floor(\mbbya/(\ksdkaro cm)+0.001)-1)*\ksdkaro cm}%
  \pgfmathsetlengthmacro{\mbgxb}{(ceil(\mbbxb/(\ksdkaro cm)-0.001)+1)*\ksdkaro cm}%
  \pgfmathsetlengthmacro{\mbgyb}{(ceil(\mbbyb/(\ksdkaro cm)-0.001)+1)*\ksdkaro cm}%
  \begin{pgfonlayer}{mbhinten}
    \draw[mbgitter,line width=0.3pt] (\mbgxa,\mbgya) grid[step=\ksdkaro cm] (\mbgxb,\mbgyb);
  \end{pgfonlayer}}
\newenvironment{ksys3}[1][]{%
  \pgfkeys{/ksys3,default,#1}%
  \pgfmathsetmacro{\ksde}{2*\ksdkaro}% Einheit in cm
  \pgfmathsetmacro{\ksapfeil}{\ksamax+0.7}% 0.7 Einheiten schräg = 0.5 Einheiten Sichtlänge
  \pgfmathsetmacro{\ksbpfeil}{\ksbmax+0.5}%
  \pgfmathsetmacro{\kscpfeil}{\kscmax+0.5}%
  \pgfsetlayers{mbhinten,main}%
  \begin{tikzpicture}[x={(-\ksdkaro cm,-\ksdkaro cm)},y={(\ksde cm,0cm)},z={(0cm,\ksde cm)},
      baseline=(current bounding box.north),execute at end picture={\mbdreigitter}]
    \draw[-{Stealth[length=2mm]},line width=0.6pt] (\ksamin,0,0) -- (\ksapfeil,0,0) node[below left] {\small$\ksaname$};
    \draw[-{Stealth[length=2mm]},line width=0.6pt] (0,\ksbmin,0) -- (0,\ksbpfeil,0) node[right] {\small$\ksbname$};
    \draw[-{Stealth[length=2mm]},line width=0.6pt] (0,0,\kscmin) -- (0,0,\kscpfeil) node[above] {\small$\kscname$};
    \foreach \a in {\ksamin,...,\ksamax}{\ifdim \a pt=0pt\else
      \pgfmathtruncatemacro{\mbrest}{mod(\a,\ksaschritt)}%
      \draw ($(\a,0,0)+(-0.85mm,0.85mm)$) -- ($(\a,0,0)+(0.85mm,-0.85mm)$)
        \ifnum\mbrest=0 node[below,inner sep=1.5pt] {\scriptsize$\pgfmathprintnumber{\a}$}\fi;\fi}
    \foreach \b in {\ksbmin,...,\ksbmax}{\ifdim \b pt=0pt\else
      \draw (0,\b,0.12) -- (0,\b,-0.12) node[below] {\scriptsize$\pgfmathprintnumber{\b}$};\fi}
    \foreach \c in {\kscmin,...,\kscmax}{\ifdim \c pt=0pt\else
      \draw (0,0.12,\c) -- (0,-0.12,\c) node[left] {\scriptsize$\pgfmathprintnumber{\c}$};\fi}
}{\end{tikzpicture}}
% Objekte im ksys3
\NewDocumentCommand{\rpunkt}{s O{above right} m m m m}{%
  \IfBooleanF{#1}{\draw[dashed,line width=0.5pt] (0,0,0) -- (#3,0,0) -- (#3,#4,0) -- (#3,#4,#5);}%
  \fill (#3,#4,#5) circle (1.6pt) node[#2,font=\small] {$#6$};}
\NewDocumentCommand{\rvektor}{O{above right} m m}{%
  \draw[-{Stealth[length=2mm]},line width=0.8pt] (0,0,0) -- (#2) node[midway,#1,font=\small] {$#3$};}
\NewDocumentCommand{\rvektorab}{O{above right} m m m}{%
  \draw[-{Stealth[length=2mm]},line width=0.8pt] (#2) -- (#3) node[midway,#1,font=\small] {$#4$};}
% Gerade: ohne Parameterbereich wird t so gewählt, dass die Gerade genau im Quader
% x1min..x1max, x2min..x2max, x3min..x3max liegt (Liang-Barsky je Achse).
\newcommand{\mbrclip}[4]{% p, u, min, max -> engt \mbrtmin, \mbrtmax ein
  \pgfmathsetmacro{\mbru}{#2}%
  \ifdim\mbru pt=0pt
    \pgfmathparse{((#1)<(#3))||((#1)>(#4))}\ifdim\pgfmathresult pt>0pt \def\mbrleer{1}\fi
  \else
    \pgfmathsetmacro{\mbrta}{((#3)-(#1))/(#2)}%
    \pgfmathsetmacro{\mbrtb}{((#4)-(#1))/(#2)}%
    \pgfmathsetmacro{\mbrtmin}{max(\mbrtmin,min(\mbrta,\mbrtb))}%
    \pgfmathsetmacro{\mbrtmax}{min(\mbrtmax,max(\mbrta,\mbrtb))}%
  \fi}
\NewDocumentCommand{\rgerade}{O{} m m m}{%
  \mbrdrei#2\relax\let\mbrpa\mbrA\let\mbrpb\mbrB\let\mbrpc\mbrC
  \mbrdrei#3\relax\let\mbrua\mbrA\let\mbrub\mbrB\let\mbruc\mbrC
  \ifblank{#1}{%
    \def\mbrtmin{-1000}\def\mbrtmax{1000}\def\mbrleer{0}%
    \mbrclip{\mbrpa}{\mbrua}{\ksamin}{\ksamax}%
    \mbrclip{\mbrpb}{\mbrub}{\ksbmin}{\ksbmax}%
    \mbrclip{\mbrpc}{\mbruc}{\kscmin}{\kscmax}%
    \pgfmathparse{\mbrtmax<=\mbrtmin}\ifdim\pgfmathresult pt>0pt \def\mbrleer{1}\fi
    \ifnum\mbrleer=1
      \PackageWarning{mathblatt}{rgerade #4: Gerade liegt ausserhalb der Achsbereiche, zeichne t=-1..3}%
      \def\mbrtmin{-1}\def\mbrtmax{3}\fi
  }{\mbrzwei#1\relax}%
  \draw[line width=0.8pt] ({\mbrpa+\mbrtmin*\mbrua},{\mbrpb+\mbrtmin*\mbrub},{\mbrpc+\mbrtmin*\mbruc})
    -- ({\mbrpa+\mbrtmax*\mbrua},{\mbrpb+\mbrtmax*\mbrub},{\mbrpc+\mbrtmax*\mbruc})
    node[above right,fill=white,inner sep=1pt,font=\small] {$#4$};}
% Ebenen: Spurdreieck (Achsenabschnitte) und Parallelogramm (Stützpunkt + Spannvektoren);
% Label in der Flächenmitte, optionales Argument = Knotenoptionen für das Label.
\NewDocumentCommand{\rebene}{O{} m m m m}{%
  \filldraw[fill=mbgrau,fill opacity=0.15,line width=0.6pt] (#2,0,0) -- (0,#3,0) -- (0,0,#4) -- cycle;
  \node[font=\small,#1] at ({(#2)/3},{(#3)/3},{(#4)/3}) {$#5$};}
\NewDocumentCommand{\rebenepar}{s O{} m m m m}{%
  \filldraw[fill=mbgrau,fill opacity=0.15,line width=0.6pt]
    (#3) -- ($(#3)+(#4)$) -- ($(#3)+(#4)+(#5)$) -- ($(#3)+(#5)$) -- cycle;
  \IfBooleanF{#1}{%
    \draw[-{Stealth[length=2mm]},line width=0.8pt] (#3) -- ($(#3)+(#4)$);
    \draw[-{Stealth[length=2mm]},line width=0.8pt] (#3) -- ($(#3)+(#5)$);}%
  \node[font=\small,#2] at ($(#3)+0.5*(#4)+0.5*(#5)$) {$#6$};}
% Körper im ksys3: Betrachter steht in Richtung (2|1|1), sichtbar sind die Flächen mit
% den größten Koordinaten. Beim Quader sind die drei Kanten an der Minimalecke verdeckt.
\NewDocumentCommand{\rquader}{m m m m}{%
  \mbrdrei#1\relax
  \pgfmathsetmacro{\mbqa}{min(\mbrA,\mbrA+(#2))}\pgfmathsetmacro{\mbqA}{max(\mbrA,\mbrA+(#2))}%
  \pgfmathsetmacro{\mbqb}{min(\mbrB,\mbrB+(#3))}\pgfmathsetmacro{\mbqB}{max(\mbrB,\mbrB+(#3))}%
  \pgfmathsetmacro{\mbqc}{min(\mbrC,\mbrC+(#4))}\pgfmathsetmacro{\mbqC}{max(\mbrC,\mbrC+(#4))}%
  \draw[dashed,line width=0.5pt] (\mbqA,\mbqb,\mbqc) -- (\mbqa,\mbqb,\mbqc) -- (\mbqa,\mbqB,\mbqc)
    (\mbqa,\mbqb,\mbqc) -- (\mbqa,\mbqb,\mbqC);
  \draw[line width=0.7pt] (\mbqA,\mbqb,\mbqc) -- (\mbqA,\mbqB,\mbqc) -- (\mbqa,\mbqB,\mbqc)
    (\mbqA,\mbqb,\mbqc) -- (\mbqA,\mbqb,\mbqC) (\mbqA,\mbqB,\mbqc) -- (\mbqA,\mbqB,\mbqC)
    (\mbqa,\mbqB,\mbqc) -- (\mbqa,\mbqB,\mbqC)
    (\mbqa,\mbqb,\mbqC) -- (\mbqA,\mbqb,\mbqC) -- (\mbqA,\mbqB,\mbqC) -- (\mbqa,\mbqB,\mbqC) -- cycle;}
\NewDocumentCommand{\rpyramide}{m m m m}{%
  \def\mbvx{2}\def\mbvy{1}\def\mbvz{1}%
  \mbrdrei#1\relax\let\mbpx\mbrA\let\mbpy\mbrB\let\mbpz\mbrC
  \mbpyramideecken{#2}{#3}{#4}%
  \mbpyramidekanten}

% ---------------------------------------------------------------------------
% L  Analysis (Objekte im ksys, sofern nicht anders vermerkt)
% ---------------------------------------------------------------------------
% \ableitungspaar[ksys-Schlüssel]{Term f}{f}{Term f'}{f'}   freistehend, zwei Systeme untereinander
%   mit gleicher x-Achse; Schlüssel wie beim ksys, dazu ymin2/ymax2/ystep2/ylabel2 für das
%   untere System. Leerer Term = leeres System (Schüler zeichnet).
%   \ableitungspaar[xmin=-3,xmax=3,ymin=-2,ymax=6,ymin2=-4,ymax2=4]{0.5*\x^2-2}{f}{\x}{f'}
% \flaeche{Term}{a}{b}{A}                 Fläche zwischen Graph und x-Achse von a bis b, grau
% \flaechezwischen{Term f}{Term g}{a}{b}{A}   Fläche zwischen zwei Graphen
% \tangentean{Term}{x0}{t}                Tangente in x0 mit Steigungsdreieck (1 nach rechts, m senkrecht);
%   \tangentean*{Term}{x0}{t}             ohne Steigungsdreieck; \tangentean[1{,}5]{...} setzt den
%                                          Steigungstext selbst (sonst numerisch, 2 Nachkommastellen)
% \hochpunkt{x}{y}{H}  \tiefpunkt{x}{y}{T}  \wendepunkt{x}{y}{W}  \wendepunkt[m]{x}{y}{W}
%   Punkt mit Label über, unter bzw. rechts über dem Punkt; Wendepunkt mit optionaler Steigung m
%   der Wendetangente (kurzes gestricheltes Stück), \wendepunkt[0] für den Sattelpunkt.
% \asymptote{x=2}{}   \asymptote{y=-1}{}   \asymptote{y=0.5*\x+1}{a}   gestrichelt, Label optional
\pgfkeys{/ksys,
  ymin2/.estore in=\ksyminu, ymax2/.estore in=\ksymaxu,
  ystep2/.estore in=\ksystepu, ylabel2/.estore in=\ksylabelu}
\NewDocumentCommand{\ableitungspaar}{O{} m m m m}{%
  \def\ksyminu{}\def\ksymaxu{}\def\ksystepu{}\def\ksylabelu{}%
  \mbksyssetup{#1}%
  \begin{tikzpicture}[x=\ksxk cm,y=\ksyk cm,baseline=(current bounding box.north)]
    \mbksysachsen
    \mbksysclip
      \ifblank{#2}{}{\funktion{#2}{#3}}
    \end{scope}
    \pgfmathsetmacro{\mbyu}{\ksymin*\ksyk}% untere Kante des oberen Systems in cm
    \pgfkeys{/ksys,default,#1}%
    \ifx\ksyminu\empty\else\pgfkeys{/ksys,ymin=\ksyminu}\fi
    \ifx\ksymaxu\empty\else\pgfkeys{/ksys,ymax=\ksymaxu}\fi
    \ifx\ksystepu\empty\else\pgfkeys{/ksys,ystep=\ksystepu}\fi
    \ifx\ksylabelu\empty\else\pgfkeys{/ksys,ylabel=\ksylabelu}\fi
    \mbksysrechnen
    \pgfmathsetmacro{\mbys}{\mbyu-1.3-\ksypfeil*\ksyk}%
    \begin{scope}[y=\ksyk cm,yshift=\mbys cm]
      \mbksysachsen
      \mbksysclip
        \ifblank{#4}{}{\funktion{#4}{#5}}
      \end{scope}
    \end{scope}
  \end{tikzpicture}}
% Flächen: Rand des Graphen durchgezogen, Begrenzungen bei a und b dünn; Label in der Mitte.
\NewDocumentCommand{\flaeche}{m m m m}{%
  \begingroup\mbxsicher
  \fill[mbgrau,fill opacity=0.3] plot[mbterm,domain=#2:#3,samples=80,smooth] (\mbt,{#1}) -- (#3,0) -- (#2,0) -- cycle;
  \draw[line width=0.4pt] plot[mbterm,domain=#2:#3,samples=80,smooth] (\mbt,{#1}) -- (#3,0) -- (#2,0) -- cycle;\endgroup
  \ifblank{#4}{}{%
    \begingroup\def\x{(((#2)+(#3))/2)}\pgfmathparse{#1}\global\let\mbfm\pgfmathresult\endgroup
    \node[font=\small] at ({((#2)+(#3))/2},{\mbfm/2}) {$#4$};}}
\NewDocumentCommand{\flaechezwischen}{m m m m m}{%
  \begingroup\mbxsicher
  \fill[mbgrau,fill opacity=0.3] plot[mbterm,domain=#3:#4,samples=80,smooth] (\mbt,{#1})
    -- plot[mbterm,domain=#4:#3,samples=80,smooth] (\mbt,{#2}) -- cycle;
  \draw[line width=0.4pt] plot[mbterm,domain=#3:#4,samples=80,smooth] (\mbt,{#1})
    -- plot[mbterm,domain=#4:#3,samples=80,smooth] (\mbt,{#2}) -- cycle;\endgroup
  \ifblank{#5}{}{%
    \begingroup\def\x{(((#3)+(#4))/2)}\pgfmathparse{#1}\global\let\mbfm\pgfmathresult
      \pgfmathparse{#2}\global\let\mbgm\pgfmathresult\endgroup
    \node[font=\small] at ({((#3)+(#4))/2},{(\mbfm+\mbgm)/2}) {$#5$};}}
% Tangente: Steigung numerisch (zentraler Differenzenquotient, h = 0.01), Gerade über \gerade,
% Label am Rand wie bei \gerade ohne optionales Argument.
\NewDocumentCommand{\tangentean}{s O{} m m m}{%
  \begingroup
    \def\x{((#4)+0.01)}\pgfmathparse{#3}\global\let\mbfp\pgfmathresult
    \def\x{((#4)-0.01)}\pgfmathparse{#3}\global\let\mbfq\pgfmathresult
    \def\x{(#4)}\pgfmathparse{#3}\global\let\mbfz\pgfmathresult
  \endgroup
  \pgfmathsetmacro{\mbm}{(\mbfp-\mbfq)/0.02}%
  \pgfmathsetmacro{\mbn}{\mbfz-\mbm*(#4)}%
  \gerade{\mbm}{\mbn}{#5}%
  \IfBooleanF{#1}{%
    \pgfmathsetmacro{\mbdx}{ifthenelse((#4)+1.3*\ksxstep>\ksxmax,-1,1)}%
    \pgfmathsetmacro{\mbxv}{(#4)+\mbdx}% senkrechte Seite des Dreiecks
    \draw[mbgrau,dashed] (#4,\mbfz) -- (\mbxv,\mbfz) -- (\mbxv,{\mbfz+\mbdx*\mbm});
    \node[below,font=\scriptsize,mbgrau] at ({(#4)+\mbdx/2},\mbfz) {1};
    % Steigungstext außen neben der senkrechten Seite; innen, wenn außen die y-Achse
    % oder der Rand im Weg ist
    \pgfmathtruncatemacro{\mbinnen}{(\mbdx>0 && ((\mbxv>-1.2*\ksxstep && \mbxv<0.2*\ksxstep) || \mbxv+\ksxstep>\ksxmax))
      || (\mbdx<0 && ((\mbxv<0.2*\ksxstep && \mbxv>-0.2*\ksxstep) || \mbxv-\ksxstep<\ksxmin))}%
    \ifnum\mbinnen=1
      \ifdim\mbdx pt>0pt \def\mbanch{left}\else\def\mbanch{right}\fi
    \else
      \ifdim\mbdx pt>0pt \def\mbanch{right}\else\def\mbanch{left}\fi
    \fi
    \node[\mbanch,font=\scriptsize,mbgrau] at (\mbxv,{\mbfz+\mbdx*\mbm/2})
      {\ifblank{#2}{$\pgfmathprintnumber[precision=2]{\mbm}$}{$#2$}};}
  \fill (#4,\mbfz) circle (1.6pt);}
% Markierte Punkte
\newcommand{\hochpunkt}[3]{\fill (#1,#2) circle (1.6pt); \ifblank{#3}{}{\node[above,font=\small,inner sep=3pt] at (#1,#2) {$#3$};}}
\newcommand{\tiefpunkt}[3]{\fill (#1,#2) circle (1.6pt); \ifblank{#3}{}{\node[below,font=\small,inner sep=3pt] at (#1,#2) {$#3$};}}
\NewDocumentCommand{\wendepunkt}{o m m m}{%
  \IfNoValueF{#1}{\draw[mbgrau,dashed] ({(#2)-0.6*\ksxstep},{(#3)-0.6*\ksxstep*(#1)}) -- ({(#2)+0.6*\ksxstep},{(#3)+0.6*\ksxstep*(#1)});}%
  \fill (#2,#3) circle (1.6pt);
  \ifblank{#4}{}{\node[above right,font=\small,inner sep=2pt] at (#2,#3) {$#4$};}}
% Asymptote: Argument  x=Wert  (senkrecht) oder  y=Term  (waagerecht/schräg, Term in \x)
\def\mbasparse#1=#2\relax{\def\mbasl{#1}\def\mbasr{#2}}
\NewDocumentCommand{\asymptote}{m m}{%
  \mbasparse#1\relax
  \if x\mbasl
    \draw[dashed,line width=0.5pt] (\mbasr,\ksymin) -- (\mbasr,\ksymax);
    \ifblank{#2}{}{\node[right,font=\small,fill=white,inner sep=1pt] at (\mbasr,{\ksymax-0.7*\ksystep}) {$#2$};}%
  \else
    \begingroup\mbxsicher
    \draw[mbterm,dashed,line width=0.5pt,domain=\ksxmin:\ksxmax,samples=40] plot (\mbt,{\mbasr});\endgroup
    \pgfmathsetmacro{\mbasx}{\ksxmax-0.15*(\ksxmax-\ksxmin)}%
    \mbfunklabel{\mbasr}{#2}{\ksxmin}{\mbasx}%
  \fi}

% ---------------------------------------------------------------------------
% M  Stochastik: dreistufiger Baum, Kreisdiagramm, Vierfeldertafel,
%    Binomialverteilung, Normalverteilung (freistehend)
% ---------------------------------------------------------------------------
% \baumdrei{S1}{S2 nach 1. Ast}{S2 nach 2. Ast}{S3 nach 1-1}{S3 nach 1-2}{S3 nach 2-1}{S3 nach 2-2}
%   Listen wie bei \baumzwei (Label/Wahrscheinlichkeit, leer = Feld). Zwei Aeste je Stufe.
% \baumdreigleich{R/0.4,B/0.6}     alle Stufen gleich (Ziehen mit Zuruecklegen)
\newcommand{\mbaeste}[6]{% Startkoordinate, y des Starts, x der Ziele, Liste, Abstand, Praefix
  \pgfmathtruncatemacro{\mban}{0}%
  \foreach \l/\p in #4{\xdef\mban{\the\numexpr\mban+1}}%
  \foreach \l/\p [count=\mbc] in #4{%
    \pgfmathsetmacro{\yy}{#2+#5*((\mban+1)/2-\mbc)}%
    \expandafter\xdef\csname mby#6\mbc\endcsname{\yy}%
    \node[ast] (#6\mbc) at (#3,\yy) {$\l$};
    \draw (#1) -- (#6\mbc) node[wk,pos=0.5] {\ifx\p\empty\underline{\hspace{5mm}}\else$\p$\fi};}}
\NewDocumentCommand{\baumdrei}{m m m m m m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.6pt,
     ast/.style={font=\small,inner sep=1.5pt}, wk/.style={font=\scriptsize,fill=white,inner sep=1pt}]
    \coordinate (S) at (0,0);
    \mbaeste{S}{0}{2.4}{{#1}}{3}{A}%
    \foreach \i in {1,2}{\ifnum\i=1 \def\mbl{#2}\else\def\mbl{#3}\fi
      \mbaeste{A\i}{\csname mbyA\i\endcsname}{4.8}{\mbl}{1.5}{B\i}}%
    \foreach \i/\j/\k in {1/1/1,1/2/2,2/1/3,2/2/4}{%
      \ifcase\k\or\def\mbl{#4}\or\def\mbl{#5}\or\def\mbl{#6}\or\def\mbl{#7}\fi
      \mbaeste{B\i\j}{\csname mbyB\i\j\endcsname}{7.2}{\mbl}{0.75}{C\i\j}}%
  \end{tikzpicture}}
\newcommand{\baumdreigleich}[1]{\baumdrei{#1}{#1}{#1}{#1}{#1}{#1}{#1}}

% \kreisdiagramm[r]{Label/Wert, ...}   Winkel proportional zu den Werten (Prozent oder absolut),
%   Label im Textmodus außen; leeres Label {} = Sektor ohne Text; leere Liste = Kreis mit Mittelpunkt.
%   Radius in cm, Voreinstellung 1.8. Sektoren beginnen oben und laufen im Uhrzeigersinn.
\NewDocumentCommand{\kreisdiagramm}{O{1.8} m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.6pt]
    \ifblank{#2}{\draw (0,0) circle (#1); \fill (0,0) circle (1.4pt);}{%
      \pgfmathsetmacro{\mbsum}{0}%
      \foreach \l/\w in {#2}{\pgfmathsetmacro{\mbsum}{\mbsum+\w}\xdef\mbsum{\mbsum}}%
      \xdef\mbwa{90}%
      \foreach \l/\w [count=\i] in {#2}{%
        \edef\mbwb{\fpeval{round(\mbwa-360*\w/\mbsum,3)}}% fpeval statt pgfmath: 360*w überläuft ab w>45
        \pgfmathsetmacro{\mbg}{0.96-0.14*mod(\i-1,4)}%
        \filldraw[fill=black!\fpeval{round((1-\mbg)*100)}] (0,0) -- (\mbwa:#1) arc (\mbwa:\mbwb:#1) -- cycle;
        \ifdefempty{\l}{}{\pgfmathsetmacro{\mbwm}{(\mbwa+\mbwb)/2}%
          \node[font=\small,anchor={\mbwm+180}] at (\mbwm:{#1+0.3}) {\l};}
        \xdef\mbwa{\mbwb}}%
      \draw (0,0) circle (#1);}
  \end{tikzpicture}}

% \sachtabelle{Spaltentypen}{Kopfzeile}{Zeilen}   Tabelle mit Rahmen, zentriert, Kopf abgesetzt.
