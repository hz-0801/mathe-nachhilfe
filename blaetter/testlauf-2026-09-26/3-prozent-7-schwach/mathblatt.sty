% \blattfuss{Lineare Funktionen}{Lernblatt Teil 1 von 3}   unverändert: Thema · Bezeichnung unten links, Seite unten rechts
\newcommand{\blattfuss}[2]{%
  \pagestyle{fancy}\fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyfoot[L]{\footnotesize\color{mbgrau}#1 \,\textperiodcentered\, #2}%
  \fancyfoot[R]{\footnotesize\color{mbgrau}Seite \thepage}%
}
% \blattkopf{Prozentrechnung}{Themenheft}   Alternative: Thema · Bezeichnung oben links, Seite unten rechts;
%   \blattkopf*{...}{...}{$\star$ = Prüfungsaufgabe} setzt zusätzlich die Legende unten links; den Text
%   liefert der Aufruf (Mathemodus für den Stern), die Vorlage enthält keinen Legendentext.
% \weit   Schalter: Teilaufgaben- und Gerüstzeilen im Aufgabenteil um gut die Hälfte weiter (Schreibraum); vor der ersten
%   Aufgabe setzen. Wirkt nicht auf Begleitteil und Hilfe-Seite (\eng setzt zurück). Voreinstellung: eng.
\newcommand{\weit}{\renewcommand{\arraystretch}{1.6}\setlength{\mbteilsep}{6pt}}
\newcommand{\eng}{\renewcommand{\arraystretch}{1.0}\setlength{\mbteilsep}{0pt}}
\newlength{\mbteilsep}\setlength{\mbteilsep}{0pt}
%   Seit Stufe 6 trägt die Kopfzeile ab der Seite, auf der eine Einheit beginnt, deren Kurzform
%   (\einheitenkopf, siehe dort): „Prozentrechnung · Lernblatt · 2 Prozentwert berechnen".
\NewDocumentCommand{\blattkopf}{s m m}{%
  \pagestyle{fancy}\fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \fancyhead[L]{\footnotesize\color{mbgrau}#2 \,\textperiodcentered\, #3\mbkopfeinheit}%
  \fancyfoot[R]{\footnotesize\color{mbgrau}Seite \thepage}%
  \IfBooleanT{#1}{\mbblattkopflegende}%
}
\NewDocumentCommand{\mbblattkopflegende}{m}{\fancyfoot[L]{\footnotesize\color{mbgrau}#1}}

% Einheitenkopf: Zwischenüberschrift über der ersten Hauptnummer einer Einheit innerhalb des Blatts.
%   \einheitenkopf{Einheit 3 von 5 · Prozentwert berechnen}      fette Zeile
%   \einheitenkopf*{Einheit 3 von 5 · Prozentwert berechnen}     fette Zeile, zusätzlich Trennstrich darunter
%   \einheitenkopf[e3]{Einheit 3 von 5 · Prozentwert berechnen}  dazu das Sprungziel e3 für \verz{e3}{…};
%   Sternform gleich: \einheitenkopf*[e3]{…}. Ohne die Option wie bisher.
% Der Kopf hängt am Folgenden: zwischen Kopf und Zweigzeile bricht die Seite nicht um. Wie weit
% der Kopf vom Folgetext absteht, merkt sich \mbkopfsprung, damit \zweigzeile diesen Abstand
% zurücknehmen kann (Stufe 5).
% Kopfzeile mit Einheit (Stufe 6): Der Kopf merkt sich seine Kurzform, und die Seitenkopfzeile von
% \blattkopf zeigt ab der Seite, auf der er steht, „Thema · Bezeichnung · Kurzform" (beginnen
% auf einer Seite mehrere Einheiten, die erste). Kurzform = Nummer und Titel ohne „Einheit" und
% ohne „von n": aus „Einheit 2 von 4 · Prozentwert berechnen" wird „2 Prozentwert berechnen",
% aus „Einheit 1 · Nullstellen" (Fokus) „1 Nullstellen", aus „Ausblick Einheit 4 von 4 · …"
% „Ausblick 4 …". Köpfe ohne „Einheit n" („Kennst du schon", „Inhalt") stehen wörtlich; die
% Abhakseite trägt so „Das kann ich". Ein zweites optionales Argument setzt die Kurzform selbst:
%   \einheitenkopf[e2][2 Prozentwert]{Einheit 2 von 4 · Prozentwert berechnen}
%   \einheitenkopf*[][Zone]{Das kennst du schon}      (leeres erstes Argument: ohne Sprungziel)
% \begleitteil und \hilfeseite setzen die Kopfzeile wieder auf „Thema · Bezeichnung" zurück.
% Unter pdflatex bleibt der Mittelpunkt in der Kurzform stehen („2 · Prozentwert berechnen").
\newlength{\mbkopfsprung}
\newif\ifmbnachkopf\mbnachkopffalse
\ExplSyntaxOn
\tl_new:N \l__mb_kurz_tl
\int_new:N \g__mb_einheit_int
\cs_new_protected:Npn \__mb_kurz_merken:
  {
    \int_gincr:N \g__mb_einheit_int
    \tl_gset_eq:cN { mbkurz@ \int_use:N \g__mb_einheit_int } \l__mb_kurz_tl
    \exp_args:Nx \mbkopfmarke { \int_use:N \g__mb_einheit_int }
  }
\cs_new_protected:Npn \mbkopfkurzsetzen #1
  { \tl_set:Nn \l__mb_kurz_tl {#1} \__mb_kurz_merken: }
\cs_new_protected:Npn \mbkopfkurzbilden #1
  {
    \tl_set:Nn \l__mb_kurz_tl {#1}
    \regex_replace_once:nnNF
      { Einheit \s+ (\d+) (?: \s+ von \s+ \d+ )? \s* \x{B7} \s* } { \1 \cS\  } \l__mb_kurz_tl
      { \regex_replace_once:nnN { Einheit \s+ (\d+) (?: \s+ von \s+ \d+ )? } { \1 } \l__mb_kurz_tl }
    \__mb_kurz_merken:
  }
\ExplSyntaxOff
% Die Marke trägt nur die laufende Nummer des Kopfs; die Kurzform liegt in \mbkurz@<Nummer>.
% Eigene Markenklasse ab LaTeX 2022-06 (\NewMarkClass), in älteren Kernen \markboth/\leftmark.
% Gezeigt wird die erste Marke der Seite (ohne Marke auf der Seite die letzte davor): Beginnen auf
% einer Seite mehrere Einheiten, steht die erste da, mit der die Seite anfängt.
\IfFormatAtLeastTF{2022-06-01}
  {\NewMarkClass{mbeinheit}%
   \newcommand{\mbkopfmarke}[1]{\InsertMark{mbeinheit}{#1}}%
   \newcommand{\mbkopfseite}{\FirstMark{mbeinheit}}}
  {\newcommand{\mbkopfmarke}[1]{\markboth{#1}{#1}}%
   \newcommand{\mbkopfseite}{\rightmark}}
\newcommand{\mbkopfeinheit}{%
  \ifnum0\mbkopfseite>\z@\,\textperiodcentered\,\csname mbkurz@\mbkopfseite\endcsname\fi}
\newcommand{\mbkopfohneeinheit}{\mbkopfmarke{0}}
\NewDocumentCommand{\einheitenkopf}{s o o m}{%
  \def\mbkopfziel{}\IfValueT{#2}{\ifblank{#2}{}{\def\mbkopfziel{\hypertarget{#2}{}}}}%
  \IfBooleanTF{#1}
    {\par\medskip\noindent{\large\bfseries\mbkopfziel\IfValueTF{#3}{\mbkopfkurzsetzen{#3}}{\mbkopfkurzbilden{#4}}#4}\par\vspace{1mm}%
     \noindent\rule{\textwidth}{0.6pt}\par\setlength{\mbkopfsprung}{\smallskipamount}}
    {\par\noindent{\large\bfseries\mbkopfziel\IfValueTF{#3}{\mbkopfkurzsetzen{#3}}{\mbkopfkurzbilden{#4}}#4}\par\setlength{\mbkopfsprung}{\medskipamount}}%
  \nobreak\vskip\mbkopfsprung\mbnachkopftrue}

% \zweigzeile{Was hier gelernt wird · Zeitmarke · Prüfungswort}
%   Zweite Zeile des Einheitenkopfs: kleiner Grad, unmittelbar unter dem Kopf, danach \medskip.
%   Steht sie direkt hinter \einheitenkopf (beide Formen), nimmt sie dessen Abstand zurück und
%   rückt so an den Kopf heran; die Seite bricht zwischen Kopf und Zweigzeile nicht um.
%   Was in die Zeile gehört, sagt ziel.md § 2 „Überschriften" (Repo mathe-nachhilfe).
%   \einheitenkopf[e2]{Einheit 2 von 5 · Prozentwert berechnen}
%   \zweigzeile{Den Prozentwert ausrechnen · neu in diesem Jahr · P10 oft}
\newcommand{\zweigzeile}[1]{\par
  \ifmbnachkopf\vskip-\mbkopfsprung\mbnachkopffalse\fi
  \nobreak\noindent{\small #1}\par\nobreak\medskip}

% Verzeichniszeile (Blattanfang, unter dem Blattkopf): eine Zeile mit den Einheiten des Blatts,
% jede klickbar auf das Ziel ihres Einheitenkopfs. Die Zeile darf umbrechen; die Trennzeichen
% setzt der Aufruf, damit er die Zeile auch auf mehrere Zeilen verteilen kann.
%   \verzeichniszeile{\verz{zone}{Kennst du schon} \verztrenn
%                     \verz{e1}{Einheit 1 · Prozentsatz} \verztrenn \verz{abhaken}{Das kann ich}}
\newcommand{\verz}[2]{\hyperlink{#1}{#2}}
\newcommand{\verztrenn}{\nobreak\hspace{0.5em}\textbullet\hspace{0.5em}}
\newcommand{\verzeichniszeile}[1]{\par\mbnachkopffalse
  \noindent{\raggedright #1\par}\addvspace{\medskipamount}}
% \einheitskopf{...}: Weiterleitung auf \einheitenkopf* (gleiches Bild wie die alte eigene.sty von
%   blaetter/prozentrechnung/2026-09-22). Altlast für abgelegte Blätter, in der Anleitung bewusst
%   nicht dokumentiert – neue Blätter verwenden \einheitenkopf.
\newcommand{\einheitskopf}[1]{\einheitenkopf*{#1}}

% Übersichtskasten: \uebersichtskasten{Text}  oder  \uebersichtskasten[Grafik]{Text}
% Mit Grafik: Text links (60 %), Grafik rechts, beide oben bündig.
\NewDocumentCommand{\uebersichtskasten}{+o +m}{%
  \begin{tcolorbox}[colback=mbkasten,colframe=mbgrau,boxrule=0.4pt,arc=1pt,
                    left=4pt,right=4pt,top=4pt,bottom=4pt]
  \IfNoValueTF{#1}{#2}{%
    \begin{minipage}[t]{0.60\linewidth}\vspace{0pt}#2\end{minipage}\hfill
    \begin{minipage}[t]{0.37\linewidth}\vspace{0pt}#1\end{minipage}}%
  \end{tcolorbox}}

% Sternlegende (einmal im Kasten): \sternlegende
\newcommand{\sternlegende}{\par\smallskip{\small$\star$ = anspruchsvoll, darf übersprungen werden}}

% Aufgaben: Umgebung aufgabe – die komplette Hauptnummer samt Teilaufgaben,
% Tabellen und Grafiken bleibt auf einer Seite; passt sie nicht mehr, rückt
% sie als Ganzes auf die nächste.
%   \begin{aufgabe}{Bestimme Steigung und y-Achsenabschnitt.}
%     \begin{teile}\teil ... \end{teile}
%     \begin{ksys}[...]\end{ksys}
%   \end{aufgabe}
\newcounter{aufgabe}
\newsavebox{\mbaufgabebox}
\newlength{\mbaufgabehoehe}
\newif\ifmbinaufgabe
\newenvironment{aufgabe}[1]{%
  \stepcounter{aufgabe}\setcounter{teil}{0}\mbinaufgabetrue\mbnachkopffalse
  \mbabhakschreiben{\theaufgabe}{#1}%
  \begin{lrbox}{\mbaufgabebox}%
  \begin{minipage}[t]{\linewidth}%
  \ifmbverfwartet\mbverfahrenzeile{\mbverfahrentext}\vskip3pt\fi
  \noindent\textbf{\theaufgabe.}\ #1\par}%
 {\end{minipage}\end{lrbox}%
  \setlength{\mbaufgabehoehe}{\dimexpr\ht\mbaufgabebox+\dp\mbaufgabebox\relax}%
  % mit wartender Verfahrensüberschrift (\verfahren, Stufe 6) deren Abstand statt 5 pt
  \par\ifmbverfwartet\addvspace{\mbverfahrenabstand}\global\mbverfwartetfalse\else\addvspace{5pt}\fi
  \ifdim\mbaufgabehoehe>\textheight
    \PackageWarning{mathblatt}{Hauptnummer \theaufgabe\space ist hoeher als eine
      Seite und wird umbrochen}%
  \else
    \Needspace*{\mbaufgabehoehe}%
  \fi
  \noindent\usebox{\mbaufgabebox}\par\addvspace{5pt}}

% Teilaufgaben: Umgebung teile; \teil{...} und \steil{...} (mit Stern)
% Der Buchstabenzaehler laeuft innerhalb einer aufgabe ueber alle teile-, teilezwei-,
% geruest-Bloecke und Listenmakros weiter; ausserhalb einer aufgabe beginnt jeder Block bei a).
\newcounter{teil}
\newcommand{\mbteilstart}{\ifmbinaufgabe\else\setcounter{teil}{0}\fi}
\newenvironment{teile}{\mbteilstart\mbanwmodus=1 \par\nopagebreak
  \begin{list}{}{\setlength{\leftmargin}{1.6em}\setlength{\labelwidth}{1.4em}
   \setlength{\labelsep}{0.2em}\setlength{\itemsep}{\mbteilsep}\setlength{\parsep}{0pt}
   \setlength{\topsep}{1pt}}}{\end{list}}
\newcommand{\teil}{\stepcounter{teil}\item[\alph{teil})]}
\newcommand{\steil}{\stepcounter{teil}\item[$\star$\,\alph{teil})]}
% Zweispaltig: Umgebung teilezwei (kurze Teilaufgaben nebeneinander)
% Buchstabe und Textanfang stehen in denselben Fluchten wie in teile: Buchstabe rechtsbuendig in
% 1.4 em, dann 0.2 em Abstand, Text ab 1.6 em, Folgezeilen einer Zelle haengen ebenso ein. Damit
% sieht eine allein stehende letzte Teilaufgabe aus wie eine Zeile aus teile, und ein Block, der
% auf teilezwei folgt, steht im gleichen Einzug. Breitere Marken (Stern) stehen wie in teile
% in ihrer natuerlichen Breite und schieben den Text der ersten Zeile nach rechts.
\newsavebox{\mbtzbox}
\newcommand{\mbtzkopf}[1]{\hangindent1.6em\hangafter1\relax
  \sbox{\mbtzbox}{#1}%
  \ifdim\wd\mbtzbox>1.4em\usebox{\mbtzbox}\else\makebox[1.4em][r]{\usebox{\mbtzbox}}\fi
  \hspace{0.2em}\ignorespaces}
\newenvironment{teilezwei}{\mbteilstart\mbanwmodus=2 \par\nopagebreak
  \begin{tabular}{@{}p{0.48\linewidth}@{}p{0.48\linewidth}@{}}}{\end{tabular}\par}
\newcommand{\tz}{\stepcounter{teil}\mbtzkopf{\alph{teil})}}
\newcommand{\stz}{\stepcounter{teil}\mbtzkopf{$\star$\,\alph{teil})}}

% Gleichungsraster: zwei Spalten, unter jeder Gleichung Schreibzeilen (grau, 9 mm) fuer die
% senkrechte Umformung. Optionales Argument = Schreibzeilen je Gleichung (Standard 2),
% je Gleichung ueberschreibbar. Stern mit \sgl. Zeilenende mit \\ wie in teilezwei.
%   \begin{gleichungsraster}[2]
%   \gl{x + 5 = 9} & \gl{x - 3 = 4} \\
%   \gl[3]{2x + 3 = 11} & \sgl[3]{7 - 2x = 15} \\
%   \end{gleichungsraster}
\newcounter{mbsz}
\newcommand{\mbglzeilen}{2}
% Schreibzeilen: je Zeile 9 mm Platz und darunter die graue Linie.
% Unter der letzten Linie fehlte bis Stufe 4 die Tiefe, die Linie lag auf der nächsten Reihe des
% Rasters bzw. auf dem Folgetext. Grund: Die Zeilen stehen in einer p-Spalte, die LaTeX mit
% \@finalstrut schließt. Steht dort \prevdepth auf dem Wert von \nointerlineskip (-1000 pt, den
% jede Schreibzeile setzt), zieht \@finalstrut eine ganze \baselineskip ab, ohne dass der
% Abschlussstrebe eine Zeilenschaltung gegenübersteht - die Spalte endet also oberhalb der
% letzten Linie. Deshalb schließt \schreibzeilen mit einem unsichtbaren Kasten der Tiefe
% \mbschreibtiefe und setzt \prevdepth auf null zurück; dann zählt die Tiefe wieder.
% \mbschreibtiefe ist 1 mm: zusammen mit der Strebe der Rasterreihe steht unter der letzten Linie
% etwa so viel Platz wie zwischen zwei Linien. Reihen mit eigenem Zusatzabstand
% (\rule{0pt}{2mm}, \noalign{\vspace{5mm}} u. ä.) bekommen dadurch mehr Luft, nie weniger.
\newlength{\mbschreibhoehe}\setlength{\mbschreibhoehe}{9mm}
\newlength{\mbschreibtiefe}\setlength{\mbschreibtiefe}{1mm}
\newcommand{\schreibzeilen}[1]{\par\setcounter{mbsz}{0}%
  \loop\ifnum\value{mbsz}<#1\relax
    \nointerlineskip\vskip\mbschreibhoehe
    \hbox{\color{black!40}\vrule\@width\linewidth\@height0.4pt\@depth\z@}%
    \stepcounter{mbsz}\repeat
  \nointerlineskip\hbox{\vrule\@width\z@\@height\z@\@depth\mbschreibtiefe}\prevdepth\z@}
\newenvironment{gleichungsraster}[1][2]{\mbteilstart\mbanwmodus=2 \renewcommand{\mbglzeilen}{#1}\par\nopagebreak
  \begin{tabular}{@{}p{0.46\linewidth}@{\hspace{0.08\linewidth}}p{0.46\linewidth}@{}}}{\end{tabular}\par}
\newcommand{\gl}[2][\mbglzeilen]{\stepcounter{teil}\alph{teil})\ $#2$\schreibzeilen{#1}}
\newcommand{\sgl}[2][\mbglzeilen]{\stepcounter{teil}$\star$\,\alph{teil})\ $#2$\schreibzeilen{#1}}

% Senkrechte Rechnung: Gleichheitszeichen untereinander, Umformung hinter dem Strich in
% eigener Spalte (&&). \beispiel setzt "Beispiel:" davor; \rechnung ohne Vorspann
% (Vorgabe-Rechnung in Fehler-finden-Aufgaben, Beispiel im Begleitteil).
%   \beispiel{x + 5 &= 9 &&\mid -5 \\ x + 5 - 5 &= 9 - 5 \\ x &= 4}
%   \beispiel{x + 4 &= 7 && x = 3 \\ 3 + 4 &= 7 \\ 7 &= 7 && \text{(wA)}\quad x = 3 \text{ ist Lösung}}
\newcommand{\rechnung}[1]{\par\nopagebreak\noindent\hspace{1.6em}$\begin{aligned}[t]#1\end{aligned}$\par\nopagebreak}
\newcommand{\mbbeispielrechnung}[1]{\par\nopagebreak\noindent Beispiel:\ $\begin{aligned}[t]#1\end{aligned}$\par\nopagebreak}

% Beispielblock (Stufe 6): Umgebung beispiel – ein eingerückter Block (1 em) mit hellgrauem
% Rahmen, erste Zeile „Beispiel:", darin frei die Gestalt einer Teilaufgabe: Angabe, Darstellung,
% Rechnung, Antwortzeile untereinander an einem Blickort. Kein Seitenumbruch im Block.
%   \begin{beispiel}
%   Der Streifen sind 10 Kinder, gefärbt sind 4 Kinder. Wie viel Prozent sind gefärbt?
%   \streifen{40}{$0$}{10 Kinder}
%   \rechnung{1 \text{ Kästchen} &= 10\,\% \\ 4 \text{ Kästchen} &= 40\,\%}
%   Antwort: 40\,\% der Kinder sind gefärbt.
%   \end{beispiel}
% \beispiel{...} (Rechnung mit „Beispiel:") und \rechnung bleiben und dürfen darin stehen.
% Teilaufgaben im Block (teile, \teil) verbrauchen keinen Buchstaben: Nach dem Block zählt die
% Hauptnummer dort weiter, wo sie davor stand.
% Umgebung und Befehl tragen denselben Namen; \beispiel unterscheidet sie selbst: Aufgerufen von
% \begin{beispiel} (\@currenvir, noch nicht im Block) öffnet es den Block, sonst setzt es die
% Rechnung.
\newif\ifmbinbeispiel\mbinbeispielfalse
\newcounter{mbbeispielteil}
\def\mbbeispielname{beispiel}
\newcommand{\beispiel}{%
  \ifmbinbeispiel\let\mbbeispielweiter\mbbeispielrechnung
  \else\ifx\@currenvir\mbbeispielname\let\mbbeispielweiter\mbbeispielanfang
  \else\let\mbbeispielweiter\mbbeispielrechnung\fi\fi
  \mbbeispielweiter}
\newcommand{\mbbeispielanfang}{\mbinbeispieltrue\setcounter{mbbeispielteil}{\value{teil}}%
  \par
  \tcolorbox[colback=white,colframe=black!30,boxrule=0.5pt,arc=1pt,
    left=5pt,right=5pt,top=3pt,bottom=4pt,enlarge left by=1em,width=\linewidth-1em,
    before skip=4pt,after skip=4pt]%
  \noindent Beispiel:\par}
\def\endbeispiel{\endtcolorbox\setcounter{teil}{\value{mbbeispielteil}}}

% Antwortfeld: \feld{m} → "m = ____"; \feld[cm]{x} → "x = ____ cm" (Feld und Einheit in einem Kasten)
% Vor dem Feld ist ein Umbruch erlaubt, aber teuer (penalty 500): TeX dehnt die Zeile nur, wenn das billiger ist.
\newcommand{\mbfeldkasten}[2]{\mbox{\underline{\hspace{#1}}\ifblank{#2}{}{\,#2}}}
\newcommand{\feld}[2][]{\unskip\penalty500\hspace{0.5em}\mbox{\ensuremath{#2 = }\mbfeldkasten{2cm}{#1}}\hspace{0.8em}}
\newcommand{\feldl}[2][]{\unskip\penalty500\hspace{0.5em}\mbox{\ensuremath{#2 = }\mbfeldkasten{3cm}{#1}}\hspace{0.8em}}
% Leeres Feld ohne Bezeichner: \leerfeld (3 cm); \leerfeld[\%] mit Einheit
\newcommand{\leerfeld}[1][]{\unskip\penalty500\hspace{0.5em}\mbfeldkasten{3cm}{#1}\hspace{0.8em}}
\newcommand{\punktfeld}{\ensuremath{S(\underline{\hspace{0.8cm}}\,|\,\underline{\hspace{0.8cm}})}}

% Antwortgerüst in Fluchten: Umgebung geruest, Zeilen mit \gz{a}{Aufgabentext}{Felder}
%   \begin{geruest}
%   \gz{a}{$y = 3x + 2$}{\feld{m}\feld{n}}
%   \gz{b}{$y = -x + 5$}{\feld{m}\feld{n}}
%   \end{geruest}
\newenvironment{geruest}{\mbteilstart\mbanwmodus=3 \par\nopagebreak
  \begin{tabular}{@{\hspace{0.4em}}l@{\hspace{0.4em}}l@{\hspace{1.2em}}l@{}}}{\end{tabular}\par}
% Aufgabentext länger als \mbgzmax (Satzspiegel minus 6 cm für die Felder) wird umbrochen.
\newlength{\mbgzmax}\newlength{\mbgzw}
\newcommand{\mbgztext}[1]{\setlength{\mbgzmax}{\dimexpr\linewidth-6cm\relax}\settowidth{\mbgzw}{#1}%
  \ifdim\mbgzw>\mbgzmax\parbox[t]{\mbgzmax}{\strut\raggedright #1\strut\vspace{2pt}}\else #1\fi}
\newcommand{\gz}[3]{\stepcounter{teil}#1) & \mbgztext{#2} & #3 \\}
\newcommand{\gzs}[3]{\stepcounter{teil}$\star$\,#1) & \mbgztext{#2} & #3 \\}

% Anweisungszeile zwischen Teilaufgaben (Stufe 6):
%   \anweisung{Rechne mit dem Taschenrechner. Runde auf eine Stelle.}
% Eine Zeile über die volle Breite der Hauptnummer, einzeilig oder umbrechend, die in teile,
% teilezwei, gleichungsraster und geruest zwischen zwei Teilaufgaben steht. Der Buchstabenzähler
% läuft unverändert weiter. Davor ein kleiner Abstand (\mbanwabstand), danach keiner.
% In den zweispaltigen Umgebungen beendet die Zeile die laufende Reihe: Sie darf direkt hinter
% der letzten Teilaufgabe der Reihe stehen (mit oder ohne \\ davor), die nächste Teilaufgabe
% beginnt links. Nicht als erster Eintrag der rechten Zelle (\tz ... & \anweisung{...}).
%   \begin{teilezwei}
%   \tz $3 \cdot 4$ & \tz $5 \cdot 6$ \\
%   \anweisung{Rechne mit dem Taschenrechner. Runde auf eine Stelle.}
%   \tz $7{,}3 \cdot 2{,}8$ & \tz $9{,}1 : 3$ \\
%   \end{teilezwei}
% Außerhalb der vier Umgebungen (zwischen zwei Blöcken einer Hauptnummer) steht sie als eigener
% Absatz. Die vier Umgebungen melden sich über \mbanwmodus: 0 frei, 1 teile, 2 zweispaltig
% (teilezwei, gleichungsraster), 3 geruest; in 2 und 3 ist die Zahl zugleich die Spaltenzahl.
% \anweisung muss am Reihenanfang einer Tabelle expandierbar bis zum \noalign sein, deshalb
% \newcommand ohne Argument und Fallunterscheidung mit \ifcase. Reihenanfang erkennt die Vorlage
% an \currentgrouptype 6 (Ausrichtungsgruppe); mitten in einer p-Zelle ist es die Gruppe der
% Zelle, dann schließt sie die Reihe zuerst mit \\.
\newcount\mbanwmodus \mbanwmodus=0
\newlength{\mbanwabstand}\setlength{\mbanwabstand}{3pt}
\newcommand{\anweisung}{%
  \ifcase\mbanwmodus\expandafter\mbanwfrei\or\expandafter\mbanwliste\else
    \ifnum\currentgrouptype=6 \expandafter\expandafter\expandafter\mbanwtab
    \else\expandafter\expandafter\expandafter\mbanwtabzu\fi\fi}
\newcommand{\mbanwfrei}[1]{\par\addvspace{\mbanwabstand}\noindent #1\par}
\newcommand{\mbanwliste}[1]{\par\addvspace{\mbanwabstand}\item[]\hspace*{-\leftmargin}%
  \parbox[t]{\dimexpr\linewidth+\leftmargin\relax}{#1}}
\newcommand{\mbanwtab}[1]{\noalign{\vskip\mbanwabstand}%
  \multicolumn{\mbanwmodus}{@{}p{\linewidth}@{}}{#1}\\}
\newcommand{\mbanwtabzu}{\\\mbanwtab}

% Rechenplatz (Stufe 6): leerer Block zum Hineinschreiben, n Zeilen à 12 mm mit hellgrauen Linien
% wie \schreibzeilen (die bleiben bei 9 mm). Er steht nach dem Titel der Hauptnummer und der
% Anweisung an der Stelle, an der früher das gedruckte Beispiel stand; der Lehrer schreibt das
% Gerüst hinein. Der Block ist ein einziger Kasten: kein Seitenumbruch darin, passt er nicht
% mehr, rutscht er ganz.
%   \rechenplatz{4}         vier Zeilen über die volle Zeilenbreite (48 mm hoch)
%   \rechenplatz[halb]{4}   knapp halbe Textbreite (0,46 wie die Spalten des gleichungsraster), für
%                           die zweispaltige Umgebung; in teilezwei bleibt zur Nachbarzelle eine Lücke
\newlength{\mbrechenhoehe}\setlength{\mbrechenhoehe}{12mm}
\newlength{\mbrechenbreite}
\NewDocumentCommand{\rechenplatz}{O{} m}{%
  \ifstrequal{#1}{halb}{\setlength{\mbrechenbreite}{0.46\textwidth}}{\setlength{\mbrechenbreite}{\linewidth}}%
  \par\addvspace{1pt}%
  {\parskip\z@\noindent
   \vbox{\hsize\mbrechenbreite\setcounter{mbsz}{0}%
     \loop\ifnum\value{mbsz}<#2\relax
       \nointerlineskip\vskip\dimexpr\mbrechenhoehe-0.4pt\relax
       \hbox{\color{black!40}\vrule\@width\mbrechenbreite\@height0.4pt\@depth\z@}%
       \stepcounter{mbsz}\repeat}\par}}

% Listenmakros: eine Zeile statt eines geruest-Blocks. Eintraege mit Komma getrennt; Dezimalkomma als 0{,}5 schreiben.
% Optionales Argument = Nummer der ersten Sternaufgabe (Sterne stehen immer am Ende).
%   \mnliste[7]{2x+3; 5x-1; ...}          a) y = 2x+3    m = __  n = __
%   \nullstellenliste[7]{x-4; 2x-6; ...}  a) y = x-4     x_0 = __
%   \punktprobenliste[7]{2x-1/A(3|5); ...} a) y = 2x-1, A(3|5)   ja / nein
\newcommand{\mbtabkopf}{\begin{tabular}{@{\hspace{0.4em}}l@{\hspace{0.4em}}l@{\hspace{1.2em}}l@{}}}
\NewDocumentCommand{\mnliste}{o m}{%
  \def\mbrows{}\mbteilstart
  \foreach \e in {#2}{\stepcounter{teil}%
    \IfNoValueTF{#1}{\def\mbs{}}{\ifnum\value{teil}<#1 \def\mbs{}\else\def\mbs{$\star$\,}\fi}%
    \edef\mbz{\mbs\alph{teil})}%
    \xappto\mbrows{\mbz & $y = \e$ & \noexpand\feld{m}\noexpand\feld{n} \noexpand\\}}%
  \par\nopagebreak\mbtabkopf\mbrows\end{tabular}\par\addvspace{3pt}}
\NewDocumentCommand{\nullstellenliste}{o m}{%
  \def\mbrows{}\mbteilstart
  \foreach \e in {#2}{\stepcounter{teil}%
    \IfNoValueTF{#1}{\def\mbs{}}{\ifnum\value{teil}<#1 \def\mbs{}\else\def\mbs{$\star$\,}\fi}%
    \edef\mbz{\mbs\alph{teil})}%
    \xappto\mbrows{\mbz & $y = \e$ & \noexpand\feldl{x_0} \noexpand\\}}%
  \par\nopagebreak\mbtabkopf\mbrows\end{tabular}\par\addvspace{3pt}}
\NewDocumentCommand{\punktprobenliste}{o m}{%
  \def\mbrows{}\mbteilstart
  \foreach \t/\pk in {#2}{\stepcounter{teil}%
    \IfNoValueTF{#1}{\def\mbs{}}{\ifnum\value{teil}<#1 \def\mbs{}\else\def\mbs{$\star$\,}\fi}%
    \edef\mbz{\mbs\alph{teil})}%
    \xappto\mbrows{\mbz & $y = \t$, \noexpand\quad $\pk$ & \noexpand\janein \noexpand\\}}%
  \par\nopagebreak\mbtabkopf\mbrows\end{tabular}\par\addvspace{3pt}}

% Ankreuzen
\newcommand{\janein}{$\square$ ja \quad $\square$ nein}
\newcommand{\kreuz}[1]{$\square$ #1\quad}

% Begleitteil / Hilfe
% (seit Stufe 6 setzen beide die Kopfzeile ohne Einheit fort, \mbkopfohneeinheit)
\newcommand{\begleitteil}{\clearpage\eng\mbkopfohneeinheit\setcounter{aufgabe}{0}%
  \section*{\normalsize Ergebnisse}}
\newcommand{\hilfeseite}{\clearpage\eng\mbkopfohneeinheit\section*{\normalsize Hilfe: Lösungsstrategie}}
% Verfahrensüberschrift (Stufe 6; bis Stufe 5 nur die fette Zwischenzeile der Hilfe-Seite):
%   \verfahren{Nullstellen aus der Scheitelpunktform}
% Zwischenzeile zwischen Einheitenkopf und Hauptnummern, wenn eine Einheit mehrere Verfahren
% nacheinander übt: halbfett (Latin Modern Roman Demi, ohne diese Schrift fett), Schriftgrad in
% der Mitte zwischen Text und Einheitenkopf, Abstand davor (\mbverfahrenabstand), kein Umbruch
% danach. Folgt direkt ein \begin{aufgabe} (Leerzeilen dazwischen erlaubt), setzt die Vorlage die
% Zeile oben in den Kasten dieser Hauptnummer; beide rücken dann nur zusammen auf die nächste
% Seite. Sonst (Hilfe-Seite vor \begin{schritte}) steht sie sofort, mit \nobreak danach.
% \abhakauto übernimmt sie als Gruppenzeile vor den Hauptnummern des Verfahrens.
%   \einheitenkopf[e2]{Einheit 2 von 3 · Nullstellen}
%   \verfahren{Nullstellen aus der Scheitelpunktform}
%   \begin{aufgabe}{Ich kann die Nullstellen aus der Scheitelpunktform ablesen.} ... \end{aufgabe}
\ifPDFTeX\let\mbhalbfett\bfseries\else
  \IfFontExistsTF{Latin Modern Roman Demi}{\newfontfamily\mbhalbfett{Latin Modern Roman Demi}}
    {\let\mbhalbfett\bfseries}\fi
\newcommand{\mbverfahrenschrift}{\begingroup\large\xdef\mbverfgrad{\f@size}\endgroup
  \fontsize{\fpeval{(\f@size+\mbverfgrad)/2}}{\fpeval{1.2*(\f@size+\mbverfgrad)/2}}\selectfont
  \mbhalbfett}
\newlength{\mbverfahrenabstand}\setlength{\mbverfahrenabstand}{10pt plus 2pt minus 2pt}
\newif\ifmbverfwartet\mbverfwartetfalse
\newcommand{\mbverfahrentext}{}
\newcommand{\mbverfahrenzeile}[1]{\noindent{\mbverfahrenschrift #1\par}}
\newcommand{\verfahren}[1]{\mbabhakgruppeschreiben{#1}\gdef\mbverfahrentext{#1}\mbverfschau}
\newcommand{\mbverfschau}{\@ifnextchar\par{\mbverfpar}{\@ifnextchar\begin{\mbverfbegin}{\mbverfsofort}}}
\def\mbverfpar\par{\mbverfschau}
\def\mbverfbegin\begin#1{\ifstrequal{#1}{aufgabe}{\global\mbverfwartettrue}{\mbverfsofort}\begin{#1}}
\newcommand{\mbverfsofort}{\par\addvspace{\mbverfahrenabstand}%
  \mbverfahrenzeile{\mbverfahrentext}\nobreak\vskip3pt\nobreak}
\newcounter{schritt}
\newenvironment{schritte}{\begin{list}{}{\setlength{\leftmargin}{1.6em}\setlength{\labelwidth}{1.4em}
   \setlength{\labelsep}{0.2em}\setlength{\itemsep}{1pt}\setlength{\parsep}{0pt}\setlength{\topsep}{1pt}}
   \setcounter{schritt}{0}}{\end{list}}
\newcommand{\schritt}{\stepcounter{schritt}\item[\theschritt.]}
\newcommand{\achtung}[1]{\par\textit{Achtung:} #1}

% Ergebniszeile: \erg{3}{a) 1 | b) 2 | ...}
\newcommand{\erg}[2]{\par\noindent\textbf{#1)}\ #2}

% Abhakseite „Das kann ich": letzte Seite des Lernblatts, eine Zeile je Hauptnummer, zum Ankreuzen.
% Beginnt auf einer neuen Seite, trägt das Sprungziel abhaken (für \verz{abhaken}{Das kann ich}).
% Die Überschrift steht im optionalen Argument, wenn sie nicht „Das kann ich" heißen soll.
%   \begin{abhakseite}
%   \zweigzeile{Hake ab, was du kannst.}
%   \abhakgruppe{Einheit 2 von 4 · Prozentwert}
%   \abhak{12}{Ich kann den Prozentsatz am Streifen ablesen}
%   \abhak{13}{Ich finde den Fehler beim Ablesen}
%   \end{abhakseite}
% \abhakgruppe setzt die Zwischenzeile einer Einheit, \abhak die Zeile mit Kästchen, Nummer und
% Titel; Folgezeilen eines langen Titels hängen unter dem Titel ein. Die Nummer darf auch
% „Z1" heißen; ist sie breiter als das Feld, rückt der Titel mit.
\newlength{\mbabhakein}\setlength{\mbabhakein}{2.8em}
\newsavebox{\mbabhakbox}
\newlength{\mbabhakbr}\newlength{\mbabhaknr}
\newenvironment{abhakseite}[1][Das kann ich]{%
  \clearpage\eng\einheitenkopf[abhaken]{#1}%
  \begingroup\small\setlength{\parskip}{1pt}\setlength{\parindent}{0pt}}%
 {\par\endgroup}
\newcommand{\abhakgruppe}[1]{\par\addvspace{4pt}\noindent\textbf{#1}\par\nobreak}
\newcommand{\abhak}[2]{\par
  \settowidth{\mbabhaknr}{#1.}%
  \ifdim\mbabhaknr<1.4em\setlength{\mbabhaknr}{1.4em}\fi
  \sbox{\mbabhakbox}{$\square$\hspace{0.45em}\makebox[\mbabhaknr][r]{#1.}\hspace{0.45em}}%
  \setlength{\mbabhakbr}{\wd\mbabhakbox}%
  \ifdim\mbabhakbr<\mbabhakein\setlength{\mbabhakbr}{\mbabhakein}\fi
  \noindent\hangindent\mbabhakbr\hangafter1
  \makebox[\mbabhakbr][l]{\usebox{\mbabhakbox}}#2\par}

% \abhakauto  (oder \abhakauto[Eigene Überschrift]) setzt dieselbe Seite ohne Handliste: die
% Titel aller \aufgabe-Köpfe des Blatts sammelt die Vorlage in der Hilfsdatei \jobname.abh (wie
% ein Inhaltsverzeichnis), der zweite xelatex-Lauf setzt sie. Die Handform oben bleibt; wer
% Gruppen will oder einzelne Zeilen anders formuliert, schreibt die Liste weiter selbst.
% Seit Stufe 6 sammelt \abhakauto auch die Verfahrensüberschriften (\verfahren) als Gruppenzeile
% (\abhakgruppe) zwischen den Hauptnummern. Eine Gruppe ohne folgende Hauptnummer (etwa ein
% \verfahren auf der Hilfe-Seite am Blattende) fällt weg.
\newwrite\mbabhakaus
\newif\ifmbabhakoffen\mbabhakoffenfalse
\newcommand{\mbabhakliste}{}
\newcommand{\mbabhakgruppewartet}{}
\newcommand{\mbabhaksammle}[2]{%
  \ifdefempty{\mbabhakgruppewartet}{}{%
    \expandafter\gappto\expandafter\mbabhakliste\expandafter{\mbabhakgruppewartet}%
    \gdef\mbabhakgruppewartet{}}%
  \gappto\mbabhakliste{\abhak{#1}{#2}}}
\newcommand{\mbabhaksammlegruppe}[1]{\gdef\mbabhakgruppewartet{\abhakgruppe{#1}}}
\newcommand{\mbabhakgruppeschreiben}[1]{%
  \ifmbabhakoffen\immediate\write\mbabhakaus{\string\abhakgruppe{\unexpanded{#1}}}\fi}
\newcommand{\mbabhaklesen}{%
  \begingroup\let\abhak\mbabhaksammle\let\abhakgruppe\mbabhaksammlegruppe
    \InputIfFileExists{\jobname.abh}{}{}%
  \endgroup
  \immediate\openout\mbabhakaus=\jobname.abh\relax\mbabhakoffentrue}
\AtBeginDocument{\mbabhaklesen}
\AtEndDocument{\ifmbabhakoffen\immediate\closeout\mbabhakaus\mbabhakoffenfalse\fi}
\newcommand{\mbabhakschreiben}[2]{%
  \ifmbabhakoffen\immediate\write\mbabhakaus{\string\abhak{#1}{\unexpanded{#2}}}\fi}
\NewDocumentCommand{\abhakauto}{O{Das kann ich}}{%
  \begin{abhakseite}[#1]%
  \ifdefempty{\mbabhakliste}
    {\PackageWarning{mathblatt}{Abhakseite noch leer - zweiter xelatex-Lauf noetig}}
    {\mbabhakliste}%
  \end{abhakseite}}

% ---------------------------------------------------------------------------
% B  Wertetabelle
% ---------------------------------------------------------------------------
% \wertetabelle{x}{y}{-2,-1,0,1,2}        → x-Zeile vorgegeben, y-Zeile leer
% \wertetabelle[7,4,1,-2]{x}{f(x)}{-2,-1,0,1,2}  → gefüllt (Begleitteil)
% \wertetabelle[,4,,-2]{x}{f(x)}{-2,-1,0,1,2}    → teilweise gefüllt: leerer Eintrag = leeres Feld
\newlength{\mbzell}\setlength{\mbzell}{1.1cm}
\newlength{\mbzeile}\setlength{\mbzeile}{0.75cm}
\NewDocumentCommand{\wertetabelle}{o m m m}{%
  \def\mbkopf{}\def\mbwerte{}\def\mbleer{}\setcounter{mbn}{0}%
  \foreach \v in {#4}{\xappto\mbkopf{& $\v$}\xappto\mbleer{& }\stepcounter{mbn}\xdef\mbnn{\arabic{mbn}}}%
  \IfNoValueTF{#1}{}{\foreach \v in {#1}{\ifdefempty{\v}{\xappto\mbwerte{& }}{\xappto\mbwerte{& $\v$}}}}%
  \begingroup\renewcommand{\arraystretch}{1.3}%
  \edef\mbpre{|>{\noexpand\columncolor{mbkasten}}c|*{\mbnn}{>{\noexpand\centering\noexpand\arraybackslash}p{\noexpand\mbzell}|}}%
  \expandafter\mbtabstart\expandafter{\mbpre}\hline
  $#2$ \mbkopf \\ \hline
  \IfNoValueTF{#1}{\rule{0pt}{\mbzeile}$#3$ \mbleer \\ \hline}{$#3$ \mbwerte \\ \hline}
  \end{tabular}\endgroup\par\addvspace{4pt}}
\newcounter{mbn}
\newcommand{\mbtabstart}[1]{\begin{tabular}{#1}}
% Leere Tabelle zum Selbstanlegen: \wertetabelleleer{x}{y}{5}
\newcommand{\wertetabelleleer}[3]{%
  \begingroup\renewcommand{\arraystretch}{1.3}%
  \begin{tabular}{|>{\columncolor{mbkasten}}c|*{#3}{p{\mbzell}|}}\hline
  $#1$ & \multicolumn{#3}{c|}{} \\ \hline
  \rule{0pt}{\mbzeile}$#2$ & \multicolumn{#3}{c|}{} \\ \hline
  \end{tabular}\endgroup\par\addvspace{4pt}}

% ---------------------------------------------------------------------------
% D  Koordinatensystem 2D
% ---------------------------------------------------------------------------
% \begin{ksys}[xmin=-4,xmax=4,ymin=-5,ymax=5]           Zeichenfläche, Karo 8 mm
% \begin{ksys}[xmin=-5,xmax=5,ymin=-5,ymax=5,ablesen]   Ablesegrafik, Karo 6 mm
% \begin{ksys}[...,klein]                               Lösungsgrafik, Karo 3.5 mm
% \begin{ksys}[leit]                                    Leitgrafik im Übersichtskasten: Karo 6 mm, -3..3
% \begin{ksys}[...,xlabel=t in min,ylabel=W in l,xstep=5,ystep=40,karo=0.16]
%   \gerade{2}{-1}{g}          y = 2x - 1, beschriftet g (an rechtem/oberem Rand)
%   \punkt{2}{3}{A}            Punkt mit Beschriftung
%   \steigungsdreieck{0}{-1}{2}   ab Punkt (0|-1), 1 nach rechts, m=2 nach oben
%   \parabel{1}{-1}{-2}{p}     y = a(x-d)^2+e mit Scheitel markiert
%   \funktion{0.5*\x^2-2}{f}   beliebiger Term in pgf-Syntax; die Variable heisst \x
%   \funktion[2.5]{...}{f}     Label an der Stelle x=2.5 (mehrere Graphen: Labels auseinanderziehen)
% \end{ksys}
% karo = Kantenlänge einer Gitterzelle in cm (nicht cm je Achseneinheit).
% Der Maßstab je Achse ergibt sich aus karo und xstep/ystep, deshalb sind
% ungleiche Achsen ohne Rechnung möglich: xstep=5, ystep=40 → Zelle bleibt 8 mm.
% Achsenzahlen: unter Karo 6 mm in \tiny statt \scriptsize; passt die breiteste
% Zahl nicht in ein Karo, wird nur jede zweite (dritte …) Zahl gesetzt, immer
% ausgehend von 0. Beides automatisch, kein Schlüssel.
\newsavebox{\mbmessbox}
\pgfkeys{/ksys/.is family, /ksys,
  xmin/.estore in=\ksxmin, xmax/.estore in=\ksxmax,
  ymin/.estore in=\ksymin, ymax/.estore in=\ksymax,
  xstep/.estore in=\ksxstep, ystep/.estore in=\ksystep,
  karo/.estore in=\kskaro,
  xlabel/.estore in=\ksxlabel, ylabel/.estore in=\ksylabel,
  ablesen/.style={karo=0.6}, klein/.style={karo=0.35},
  leit/.style={karo=0.6,xmin=-3,xmax=3,ymin=-3,ymax=3},
  default/.style={xmin=-4,xmax=4,ymin=-4,ymax=4,xstep=1,ystep=1,karo=0.8,xlabel=$x$,ylabel=$y$,pizahlen=false}}
% Kern des ksys in drei Hilfsmakros, damit \ableitungspaar zwei Systeme in ein Bild setzen kann:
% \mbksyssetup{Schlüssel} liest Schlüssel und rechnet Maßstäbe, \mbksysachsen zeichnet Gitter,
% Achsen und Bezifferung, \mbksysclip öffnet den Clip-Bereich (Scope wird vom Aufrufer geschlossen).
\newcommand{\mbksyssetup}[1]{\pgfkeys{/ksys,default,#1}\mbksysrechnen}
\newcommand{\mbksysrechnen}{%
  \pgfmathsetmacro{\ksxk}{\kskaro/\ksxstep}%
  \pgfmathsetmacro{\ksyk}{\kskaro/\ksystep}%
  \pgfmathsetmacro{\kstx}{0.12*\ksxstep}%
  \pgfmathsetmacro{\ksty}{0.12*\ksystep}%
  \pgfmathsetmacro{\ksxpfeil}{\ksxmax+0.5*\ksxstep}%
  \pgfmathsetmacro{\ksypfeil}{\ksymax+0.5*\ksystep}%
  \pgfmathsetmacro{\ksxa}{\ksxmin+\ksxstep}\pgfmathsetmacro{\ksya}{\ksymin+\ksystep}%
  \ifdim\kskaro cm<0.6cm \def\mbtf{\tiny}\else\def\mbtf{\scriptsize}\fi
  \xdef\mbwmax{0pt}% breiteste x-Zahl bestimmt die Ausduennung
  \foreach \x in {\ksxmin,\ksxa,...,\ksxmax}{\sbox\mbmessbox{\mbtf$\pgfmathprintnumber{\x}$}%
    \ifdim\wd\mbmessbox>\mbwmax\xdef\mbwmax{\the\wd\mbmessbox}\fi}%
  \edef\mbhh{\the\dimexpr\ht\mbmessbox+\dp\mbmessbox\relax}%
  \pgfmathtruncatemacro{\ksxl}{max(1,ceil((\mbwmax+2pt)/(\kskaro cm)))}%
  \pgfmathtruncatemacro{\ksyl}{max(1,ceil((\mbhh+2pt)/(\kskaro cm)))}}
\newcommand{\mbksysachsen}{%
    \draw[mbgitter,line width=0.3pt] (\ksxmin,\ksymin) grid[xstep=\ksxstep,ystep=\ksystep] (\ksxmax,\ksymax);
    \draw[-{Stealth[length=2mm]},line width=0.6pt] (\ksxmin,0) -- (\ksxpfeil,0) node[right] {\small\ksxlabel};
    \draw[-{Stealth[length=2mm]},line width=0.6pt] (0,\ksymin) -- (0,\ksypfeil) node[above] {\small\ksylabel};
    \foreach \x in {\ksxmin,\ksxa,...,\ksxmax}{\ifdim \x pt=0pt\else
      \pgfmathtruncatemacro{\mbrest}{mod(abs(round(\x/\ksxstep)),\ksxl)}%
      \draw (\x,\ksty) -- (\x,-\ksty)
        \ifnum\mbrest=0 node[below,inner sep=1.5pt] {\mbtf$\ifmbpizahlen\mbpizahl{\x}\else\pgfmathprintnumber{\x}\fi$}\fi;\fi}
    \foreach \y in {\ksymin,\ksya,...,\ksymax}{\ifdim \y pt=0pt\else
      \pgfmathtruncatemacro{\mbrest}{mod(abs(round(\y/\ksystep)),\ksyl)}%
      \draw (\kstx,\y) -- (-\kstx,\y)
        \ifnum\mbrest=0 node[left,inner sep=1.5pt] {\mbtf$\pgfmathprintnumber{\y}$}\fi;\fi}}
% x-Zahl als Vielfaches von pi/2: \mbpizahl{4.7124} -> \frac{3\pi}{2}
\newcommand{\mbpizahl}[1]{\pgfmathtruncatemacro{\mbpk}{round(2*(#1)/pi)}%
  \pgfmathtruncatemacro{\mbpg}{\mbpk/2}\pgfmathtruncatemacro{\mbpr}{abs(\mbpk)-2*abs(\mbpg)}%
  \ifnum\mbpr=0 \ifnum\mbpg=1 \pi\else\ifnum\mbpg=-1 -\pi\else\mbpg\pi\fi\fi
  \else\ifnum\mbpk<0 -\fi\ifnum\mbpk=1 \tfrac{\pi}{2}\else\ifnum\mbpk=-1 \tfrac{\pi}{2}\else\tfrac{\the\numexpr\ifnum\mbpk<0 -\fi\mbpk\relax\pi}{2}\fi\fi\fi}
\newcommand{\mbksysclip}{\begin{scope}\clip (\ksxmin,\ksymin) rectangle (\ksxmax,\ksymax);}
\newenvironment{ksys}[1][]{%
  \mbksyssetup{#1}%
  \begin{tikzpicture}[x=\ksxk cm,y=\ksyk cm,baseline=(current bounding box.north)]
  \mbksysachsen
  \mbksysclip
}{\end{scope}\end{tikzpicture}}
% Objekte im ksys
\newcommand{\gerade}{}
% \gerade{m}{n}{Label}  oder  \gerade[x]{m}{n}{Label} – x = Stelle, an der das
% Label sitzt (Achseneinheiten). Bei mehreren Geraden in einem System die Labels
% mit verschiedenen x auseinanderziehen, statt die Aufgabenwerte zu aendern.
\RenewDocumentCommand{\gerade}{o m m m}{%
  \draw[line width=0.8pt,domain=\ksxmin:\ksxmax,samples=2] plot (\x,{#2*\x+#3});
  \ifblank{#4}{}{\IfNoValueTF{#1}{\mbgeradelabel{\ksxmax-0.6*\ksxstep}{#2}{#3}{#4}}{\mbgeradelabel{#1}{#2}{#3}{#4}}}}
% Label einer Geraden an der Stelle x. Liegt der Punkt oben oder unten außerhalb der Zeichen-
% fläche, wandert er auf die Kante, an der er hinausgelaufen ist (nicht nach Vorzeichen von m);
% liegt er dann seitlich außerhalb, sucht \mbfunklabel vom rechten Rand her eine Stelle im Bild.
% Vorher konnte der Ausweichpunkt außerhalb liegen und wurde vom Clipping stumm entfernt.
\newcommand{\mbgeradelabel}[4]{% x, m, n, Label
  \pgfmathsetmacro{\mblx}{#1}\pgfmathsetmacro{\mbly}{#2*\mblx+#3}%
  \pgfmathtruncatemacro{\mbltop}{\mbly>\ksymax-0.3*\ksystep}%
  \pgfmathtruncatemacro{\mblbot}{\mbly<\ksymin+0.3*\ksystep}%
  \ifnum\mbltop=1 \pgfmathsetmacro{\mbly}{\ksymax-0.5*\ksystep}\pgfmathsetmacro{\mblx}{(\mbly-#3)/(#2+0.000001)}\fi
  \ifnum\mblbot=1 \pgfmathsetmacro{\mbly}{\ksymin+0.5*\ksystep}\pgfmathsetmacro{\mblx}{(\mbly-#3)/(#2+0.000001)}\fi
  % nicht auf den Achsen sitzen: dort steht die Bezifferung
  \pgfmathtruncatemacro{\mblachse}{(abs(\mbly)<0.7*\ksystep)||(abs(\mblx)<0.7*\ksxstep)}%
  \ifnum\mblachse=1
    \pgfmathsetmacro{\mblx}{\mblx-1.3*\ksxstep}\pgfmathsetmacro{\mbly}{#2*\mblx+#3}%
    \pgfmathtruncatemacro{\mblachse}{(abs(\mbly)<0.7*\ksystep)||(abs(\mblx)<0.7*\ksxstep)}%
    \ifnum\mblachse=1 \pgfmathsetmacro{\mblx}{\mblx+2.6*\ksxstep}\pgfmathsetmacro{\mbly}{#2*\mblx+#3}\fi
  \fi
  \pgfmathtruncatemacro{\mblin}{(\mblx>\ksxmin+0.3*\ksxstep)&&(\mblx<\ksxmax-0.3*\ksxstep)&&(\mbly>\ksymin+0.3*\ksystep)&&(\mbly<\ksymax-0.3*\ksystep)}%
  \ifnum\mblin=1
    \node[fill=white,inner sep=1pt,font=\small] at (\mblx,\mbly) {$#4$};
  \else
    \mbfunklabel{#2*\x+#3}{#4}{\ksxmin}{\ksxmax}%
  \fi}
\newcommand{\punkt}[3]{\fill (#1,#2) circle (1.6pt) node[above right,font=\small] {$#3$};}
\newcommand{\steigungsdreieck}[3]{%
  \draw[mbgrau,dashed] (#1,#2) -- ({#1+1},#2) -- ({#1+1},{#2+#3});
  \node[below,font=\scriptsize,mbgrau] at ({#1+0.5},#2) {1};
  \node[right,font=\scriptsize,mbgrau] at ({#1+1},{#2+#3/2}) {$#3$};}
\newcommand{\parabel}[4]{%
  \draw[line width=0.8pt,domain=\ksxmin:\ksxmax,samples=80,smooth] plot (\x,{#1*(\x-#2)^2+#3});
  \mbfunklabel{(#1)*(\x-(#2))^2+(#3)}{#4}{\ksxmin}{\ksxmax}%
  \fill (#2,#3) circle (1.4pt);}
% Nutzerterme in \x: pgfmath rechnet -2^2 = -4, deshalb wird \x als geklammerter Wert (\mbt)
% eingesetzt. Alle plot-Aufrufe mit Nutzertermen laufen über mbterm und \mbxsicher.
\tikzset{mbterm/.style={variable=\mbt}}
\newcommand{\mbxsicher}{\def\x{(\mbt)}}
% Kurvenlabel: pos= auf plot-Pfaden ist unzuverlässig, deshalb sucht \mbfunklabel vom rechten
% Rand aus die erste Stelle, an der der Graph innerhalb der Zeichenfläche liegt (40 Schritte).
\newcommand{\mbfunklabel}[4]{% Term, Label, von, bis
  \ifblank{#2}{}{%
    \pgfmathsetmacro{\mbfx}{#4}\pgfmathsetmacro{\mbfd}{((#4)-(#3))/40}%
    \def\mbfn{0}\def\mbfok{0}%
    \loop
      \begingroup\edef\x{(\mbfx)}\pgfmathparse{#1}\global\let\mbfy\pgfmathresult\endgroup
      \pgfmathtruncatemacro{\mbfok}{(\mbfy<\ksymax-0.3*\ksystep)&&(\mbfy>\ksymin+0.3*\ksystep)}%
      \pgfmathtruncatemacro{\mbfn}{\mbfn+1}%
      \ifnum\mbfok=0 \pgfmathsetmacro{\mbfx}{\mbfx-\mbfd}\fi
      \pgfmathtruncatemacro{\mbfgo}{(\mbfok==0)&&(\mbfn<40)}%
    \ifnum\mbfgo=1 \repeat
    \ifnum\mbfok=1
      \node[fill=white,inner sep=1pt,font=\small] at (\mbfx,\mbfy) {$#2$};
    \else\PackageWarning{mathblatt}{Label #2: Graph liegt im Bereich nicht in der Zeichenflaeche}\fi}}
\NewDocumentCommand{\funktion}{o m m}{%
  \begingroup\mbxsicher
  \draw[mbterm,line width=0.8pt,domain=\ksxmin:\ksxmax,samples=120,smooth] plot (\mbt,{#2});\endgroup
  \IfNoValueTF{#1}{\mbfunklabel{#2}{#3}{\ksxmin}{\ksxmax}}{\mbfunklabel{#2}{#3}{\ksxmin}{#1}}}
\NewDocumentCommand{\funktionab}{o m m m m}{% [Labelstelle] Term, Label, von, bis  (bei Definitionslücken)
  \begingroup\mbxsicher
  \draw[mbterm,line width=0.8pt,domain=#4:#5,samples=120,smooth] plot (\mbt,{#2});\endgroup
  \IfNoValueTF{#1}{\mbfunklabel{#2}{#3}{#4}{#5}}{\mbfunklabel{#2}{#3}{#4}{#1}}}
% Zwei Systeme nebeneinander: \ksysabstand dazwischen
\newcommand{\ksysabstand}{\hspace{1.0cm}}

% ---------------------------------------------------------------------------
% E  Dreieck
% ---------------------------------------------------------------------------
% \dreieck{(0,0)}{(5,0)}{(1.5,3)}{a}{b}{c}{\alpha}{\beta}{\gamma}   allgemein
% \dreieckrw{4}{3}{a}{b}{c}    rechtwinklig bei C, Katheten a (waagerecht), b (senkrecht)
%   Leere Beschriftung {} lässt das Label weg. Koordinaten in cm.
\NewDocumentCommand{\dreieck}{m m m m m m m m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north)]
    \coordinate (A) at #1; \coordinate (B) at #2; \coordinate (C) at #3;
    \draw[line width=0.8pt] (A) -- (B) -- (C) -- cycle;
    \node[below left,font=\small] at (A) {$A$};
    \node[below right,font=\small] at (B) {$B$};
    \node[above,font=\small] at (C) {$C$};
    \path (B) -- (C) node[midway,above right,font=\small] {$#4$};
    \path (A) -- (C) node[midway,above left,font=\small] {$#5$};
    \path (A) -- (B) node[midway,below,font=\small] {$#6$};
    \node[font=\small] at ($(A)+(0.55,0.22)$) {$#7$};
    \node[font=\small] at ($(B)+(-0.55,0.22)$) {$#8$};
    \node[font=\small] at ($(C)+(0,-0.45)$) {$#9$};
  \end{tikzpicture}}
\NewDocumentCommand{\dreieckrw}{m m m m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north)]
    \coordinate (C) at (0,0); \coordinate (B) at (#1,0); \coordinate (A) at (0,#2);
    \draw[line width=0.8pt] (A) -- (B) -- (C) -- cycle;
    \draw (0.35,0) -- (0.35,0.35) -- (0,0.35); \fill (0.17,0.17) circle (0.8pt);
    \node[above,font=\small] at (A) {$A$};
    \node[right,font=\small] at (B) {$B$};
    \node[below left,font=\small] at (C) {$C$};
    \path (C) -- (B) node[midway,below,font=\small] {$#3$};
    \path (C) -- (A) node[midway,left,font=\small] {$#4$};
    \path (A) -- (B) node[midway,above right,font=\small] {$#5$};
  \end{tikzpicture}}

% ---------------------------------------------------------------------------
% Hilfsmakros für Körper (F) und Objekte im ksys3 (I)
% ---------------------------------------------------------------------------
% \mbrdrei x,y,z\relax → \mbrA \mbrB \mbrC ;  \mbrzwei a:b\relax → \mbrtmin \mbrtmax
\def\mbrdrei#1,#2,#3\relax{\def\mbrA{#1}\def\mbrB{#2}\def\mbrC{#3}}
\def\mbrzwei#1:#2\relax{\def\mbrtmin{#1}\def\mbrtmax{#2}}
% Sichtbarkeit einer Fläche: \mbsicht{K}{L}{S}{M} setzt \mbvis auf 1, wenn die Fläche
% durch K, L, S dem Betrachter zugewandt ist; M ist ein innerer Punkt des Körpers.
% Blickvektor \mbvx,\mbvy,\mbvz (Richtung zum Betrachter) setzt der Aufrufer:
% Körper in F (Tiefe nach rechts oben): (1|-2|1); ksys3: (2|1|1).
\newcommand{\mbsicht}[4]{%
  \expandafter\mbrdrei#1\relax\let\mbkx\mbrA\let\mbky\mbrB\let\mbkz\mbrC
  \expandafter\mbrdrei#2\relax\let\mblx\mbrA\let\mbly\mbrB\let\mblz\mbrC
  \expandafter\mbrdrei#3\relax\let\mbsx\mbrA\let\mbsy\mbrB\let\mbsz\mbrC
  \expandafter\mbrdrei#4\relax\let\mbmx\mbrA\let\mbmy\mbrB\let\mbmz\mbrC
  \pgfmathsetmacro{\mbnx}{(\mbly-\mbky)*(\mbsz-\mbkz)-(\mblz-\mbkz)*(\mbsy-\mbky)}%
  \pgfmathsetmacro{\mbny}{(\mblz-\mbkz)*(\mbsx-\mbkx)-(\mblx-\mbkx)*(\mbsz-\mbkz)}%
  \pgfmathsetmacro{\mbnz}{(\mblx-\mbkx)*(\mbsy-\mbky)-(\mbly-\mbky)*(\mbsx-\mbkx)}%
  \pgfmathsetmacro{\mbda}{\mbnx*\mbvx+\mbny*\mbvy+\mbnz*\mbvz}%
  \pgfmathsetmacro{\mbdb}{\mbnx*(\mbmx-\mbkx)+\mbny*(\mbmy-\mbky)+\mbnz*(\mbmz-\mbkz)}%
  \pgfmathtruncatemacro{\mbvis}{(\mbda>0&&\mbdb<0)||(\mbda<0&&\mbdb>0)}}
% Kante: \mbkante{n}{P}{Q} – durchgezogen, wenn n>0 (Zahl der sichtbaren Nachbarflächen)
\newcommand{\mbkante}[3]{\pgfmathtruncatemacro{\mbkn}{#1}\ifnum\mbkn>0 \draw[line width=0.7pt] (#2) -- (#3);\else
  \draw[dashed,line width=0.5pt] (#2) -- (#3);\fi}
% Eckpunkte einer Rechteckpyramide aus Minimalecke (\mbpx,\mbpy,\mbpz), Kanten a (x-Richtung),
% b (y-Richtung), Spitze S als Tripel → Makros \mbpa..\mbpd, \mbps und Komponenten
\newcommand{\mbpyramideecken}[3]{%
  \pgfmathsetmacro{\mbpax}{\mbpx}\pgfmathsetmacro{\mbpay}{\mbpy}\pgfmathsetmacro{\mbpaz}{\mbpz}%
  \pgfmathsetmacro{\mbpbx}{\mbpx+(#1)}\let\mbpby\mbpay\let\mbpbz\mbpaz
  \let\mbpcx\mbpbx\pgfmathsetmacro{\mbpcy}{\mbpy+(#2)}\let\mbpcz\mbpaz
  \let\mbpdx\mbpax\let\mbpdy\mbpcy\let\mbpdz\mbpaz
  \mbrdrei#3\relax\pgfmathsetmacro{\mbpsx}{\mbrA}\pgfmathsetmacro{\mbpsy}{\mbrB}\pgfmathsetmacro{\mbpsz}{\mbrC}%
  \edef\mbpa{\mbpax,\mbpay,\mbpaz}\edef\mbpb{\mbpbx,\mbpby,\mbpbz}%
  \edef\mbpc{\mbpcx,\mbpcy,\mbpcz}\edef\mbpd{\mbpdx,\mbpdy,\mbpdz}\edef\mbps{\mbpsx,\mbpsy,\mbpsz}}
% Alle acht Kanten der Pyramide, verdeckte gestrichelt (nach \mbpyramideecken)
\newcommand{\mbpyramidekanten}{%
  \pgfmathsetmacro{\mbmx}{(\mbpax+\mbpcx)/4+\mbpsx/2}\pgfmathsetmacro{\mbmy}{(\mbpay+\mbpcy)/4+\mbpsy/2}%
  \pgfmathsetmacro{\mbmz}{(\mbpaz+\mbpcz)/4+\mbpsz/2}\edef\mbpm{\mbmx,\mbmy,\mbmz}%
  \mbsicht{\mbpa}{\mbpb}{\mbps}{\mbpm}\let\mbfa\mbvis
  \mbsicht{\mbpb}{\mbpc}{\mbps}{\mbpm}\let\mbfb\mbvis
  \mbsicht{\mbpc}{\mbpd}{\mbps}{\mbpm}\let\mbfc\mbvis
  \mbsicht{\mbpd}{\mbpa}{\mbps}{\mbpm}\let\mbfd\mbvis
  \mbsicht{\mbpa}{\mbpb}{\mbpc}{\mbpm}\let\mbfg\mbvis
  \mbkante{\mbfg+\mbfa}{\mbpa}{\mbpb}\mbkante{\mbfg+\mbfb}{\mbpb}{\mbpc}%
  \mbkante{\mbfg+\mbfc}{\mbpc}{\mbpd}\mbkante{\mbfg+\mbfd}{\mbpd}{\mbpa}%
  \mbkante{\mbfd+\mbfa}{\mbpa}{\mbps}\mbkante{\mbfa+\mbfb}{\mbpb}{\mbps}%
  \mbkante{\mbfb+\mbfc}{\mbpc}{\mbps}\mbkante{\mbfc+\mbfd}{\mbpd}{\mbps}}

% ---------------------------------------------------------------------------
% F  Körper (Schrägbild, Kavalier 45°, Tiefe halbiert)
% ---------------------------------------------------------------------------
% \quader{4}{2}{3}{a}{b}{c}   Länge, Tiefe, Höhe in cm; Labels (leer = ohne)
% \zylinder{1.5}{3}{r}{h}     Radius, Höhe
% \prismadreieck{4}{3}{2}{}{}{}   Grundkante, Grundhöhe (Dreieck), Tiefe
% \pyramide{4}{3}{3.5}{a}{b}{h}  Rechteckpyramide: Grundkanten a (vorn), b (Tiefe), Höhe h;
%                                quadratisch mit a = b. Höhe gestrichelt mit Fußpunkt.
% \kegel{1.5}{3}{r}{h}{s}     Radius, Höhe; Labels r, h, s (Mantellinie), leer = ohne
% \kugel{1.5}{r}              Radius; Äquator angedeutet, Radius gestrichelt
\NewDocumentCommand{\quader}{m m m m m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),
     x={(1cm,0cm)},y={(0.5cm,0.5cm)},z={(0cm,1cm)},line width=0.7pt]
    \draw (0,0,0) -- (#1,0,0) -- (#1,0,#3) -- (0,0,#3) -- cycle;
    \draw (#1,0,0) -- (#1,#2,0) -- (#1,#2,#3) -- (#1,0,#3);
    \draw (0,0,#3) -- (0,#2,#3) -- (#1,#2,#3);
    \draw[dashed,line width=0.5pt] (0,0,0) -- (0,#2,0) -- (#1,#2,0);
    \draw[dashed,line width=0.5pt] (0,#2,0) -- (0,#2,#3);
    \node[below,font=\small] at ({#1/2},0,0) {$#4$};
    \node[below right,font=\small] at (#1,{#2/2},0) {$#5$};
    \node[left,font=\small] at (0,0,{#3/2}) {$#6$};
  \end{tikzpicture}}
\NewDocumentCommand{\zylinder}{m m m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.7pt]
    \draw (0,#2) ellipse ({#1} and {#1*0.35});
    \draw (-#1,0) -- (-#1,#2); \draw (#1,0) -- (#1,#2);
    \draw (-#1,0) arc (180:360:{#1} and {#1*0.35});
    \draw[dashed,line width=0.5pt] (-#1,0) arc (180:0:{#1} and {#1*0.35});
    \fill (0,#2) circle (0.8pt);
    \draw[dashed,line width=0.5pt] (0,#2) -- (#1,#2) node[midway,fill=white,inner sep=1pt,font=\small] {$#3$};
    \node[right,font=\small] at (#1,{#2/2}) {$#4$};
  \end{tikzpicture}}
\NewDocumentCommand{\prismadreieck}{m m m m m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),
     x={(1cm,0cm)},y={(0.5cm,0.5cm)},z={(0cm,1cm)},line width=0.7pt]
    \draw (0,0,0) -- (#1,0,0) -- ({#1/2},0,#2) -- cycle;
    \draw (#1,0,0) -- (#1,#3,0) -- ({#1/2},#3,#2) -- ({#1/2},0,#2);
    \draw[dashed,line width=0.5pt] (0,0,0) -- (0,#3,0) -- (#1,#3,0);
    \draw[dashed,line width=0.5pt] (0,#3,0) -- ({#1/2},#3,#2);
    \node[below,font=\small] at ({#1/2},0,0) {$#4$};
    \ifblank{#5}{}{\draw[dashed,line width=0.5pt] ({#1/2},0,0) -- ({#1/2},0,#2)
      node[midway,right,inner sep=1.5pt,font=\small] {$#5$};
      \draw[line width=0.4pt] ({#1/2},0,0.22) -- ({#1/2+0.22},0,0.22) -- ({#1/2+0.22},0,0);}
    \node[below right,font=\small] at (#1,{#3/2},0) {$#6$};
  \end{tikzpicture}}
\NewDocumentCommand{\pyramide}{m m m m m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),
     x={(1cm,0cm)},y={(0.5cm,0.5cm)},z={(0cm,1cm)}]
    \def\mbvx{1}\def\mbvy{-2}\def\mbvz{1}%
    \def\mbpx{0}\def\mbpy{0}\def\mbpz{0}%
    \mbpyramideecken{#1}{#2}{{(#1)/2},{(#2)/2},{#3}}%
    \mbpyramidekanten
    \fill ({(#1)/2},{(#2)/2},0) circle (0.8pt);
    \draw[dashed,line width=0.5pt] ({(#1)/2},{(#2)/2},0) -- ({(#1)/2},{(#2)/2},#3)
      node[midway,left,inner sep=1.5pt,font=\small] {$#6$};
    \draw[line width=0.4pt] ({(#1)/2},{(#2)/2},0.22) -- ({(#1)/2+0.22},{(#2)/2},0.22) -- ({(#1)/2+0.22},{(#2)/2},0);
    \node[below,font=\small] at ({(#1)/2},0,0) {$#4$};
    \node[below right,font=\small] at (#1,{(#2)/2},0) {$#5$};
  \end{tikzpicture}}
\NewDocumentCommand{\kegel}{m m m m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.7pt]
    \draw (-#1,0) -- (0,#2) -- (#1,0);
    \draw (-#1,0) arc (180:360:{#1} and {#1*0.35});
    \draw[dashed,line width=0.5pt] (-#1,0) arc (180:0:{#1} and {#1*0.35});
    \fill (0,0) circle (0.8pt);
    \draw[dashed,line width=0.5pt] (0,0) -- (0,#2) node[midway,left,inner sep=1.5pt,font=\small] {$#4$};
    \draw[dashed,line width=0.5pt] (0,0) -- (#1,0) node[midway,fill=white,inner sep=1pt,font=\small] {$#3$};
    \draw[line width=0.4pt] (0,0.18) -- (0.18,0.18) -- (0.18,0);
    \path (#1,0) -- (0,#2) node[midway,above right,inner sep=1.5pt,font=\small] {$#5$};
