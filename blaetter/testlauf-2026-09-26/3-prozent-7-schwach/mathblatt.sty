% \vierfeldertafel{A}{B}{n11,n12,n1s,n21,n22,n2s,ns1,ns2,n}   zeilenweise: B / nicht B / Summe,
%   spaltenweise A / nicht A / Summe. Leere Eintraege lassen das Feld frei, {} alles leer.
\def\mbvfneun#1,#2,#3,#4,#5,#6,#7,#8,#9\relax{\def\vfa{#1}\def\vfb{#2}\def\vfc{#3}\def\vfd{#4}%
  \def\vfe{#5}\def\vff{#6}\def\vfg{#7}\def\vfh{#8}\def\vfi{#9}}
\newcommand{\mbvfz}[1]{\ifblank{#1}{\rule{0pt}{0.65cm}}{\rule{0pt}{0.65cm}$#1$}}
\NewDocumentCommand{\vierfeldertafel}{m m m}{%
  \ifblank{#3}{\mbvfneun,,,,,,,,\relax}{\mbvfneun#3\relax}%
  \begingroup\renewcommand{\arraystretch}{1.3}%
  \begin{tabular}{|>{\columncolor{mbkasten}}c|>{\centering\arraybackslash}p{1.5cm}|>{\centering\arraybackslash}p{1.5cm}|>{\centering\arraybackslash}p{1.5cm}|}\hline
  \cellcolor{mbkasten} & \cellcolor{mbkasten}$#1$ & \cellcolor{mbkasten}$\overline{#1}$ & \cellcolor{mbkasten} \\ \hline
  $#2$ & \mbvfz{\vfa} & \mbvfz{\vfb} & \mbvfz{\vfc} \\ \hline
  $\overline{#2}$ & \mbvfz{\vfd} & \mbvfz{\vfe} & \mbvfz{\vff} \\ \hline
  & \mbvfz{\vfg} & \mbvfz{\vfh} & \mbvfz{\vfi} \\ \hline
  \end{tabular}\endgroup\par\addvspace{4pt}}

% \binomialverteilung[Schlüssel]{n}{p}   Stabdiagramm P(X=k) für k = von..bis (Voreinstellung 0..n).
%   Schlüssel: von, bis, ymax, ystep (ohne Angabe automatisch), karo (0.5), markiere=a:b (Stäbe a..b dunkel).
%   Bei n > 25 ohne von/bis: nur k mit P(X=k) >= 0.0005, Warnung im Log. Rechnung über Logarithmen.
%   Breite = (bis-von+1) Karos; über 30 Stäbe passen nicht in die Zeile.
\pgfkeys{/bin/.is family, /bin,
  von/.estore in=\bnvon, bis/.estore in=\bnbis, ymax/.estore in=\bnymax, ystep/.estore in=\bnystep,
  karo/.estore in=\bnkaro, markiere/.estore in=\bnmark,
  default/.style={von=0,bis=,ymax=,ystep=,karo=0.5,markiere=}}
\newcommand{\mbbinp}[3]{% n, p, k -> \mbbp
  \pgfmathsetmacro{\mblc}{0}%
  \pgfmathtruncatemacro{\mbkk}{#3}%
  \ifnum\mbkk>0 \foreach \i in {1,...,\mbkk}{\pgfmathsetmacro{\mblc}{\mblc+ln(#1-\mbkk+\i)-ln(\i)}\xdef\mblc{\mblc}}\fi
  \pgfmathsetmacro{\mble}{\mblc+\mbkk*ln(#2)+(#1-\mbkk)*ln(1-(#2))}%
  \pgfmathsetmacro{\mbbp}{ifthenelse(\mble<-11,0,exp(\mble))}}
\NewDocumentCommand{\binomialverteilung}{O{} m m}{%
  \pgfkeys{/bin,default,#1}%
  \ifx\bnbis\empty\edef\bnbis{#2}%
    \ifnum#2>25 % grosses n: Bereich auf P(X=k) >= 0.0005 einschraenken
      \def\bnvon{}\foreach \k in {0,...,#2}{\mbbinp{#2}{#3}{\k}%
        \pgfmathparse{\mbbp>=0.0005}\ifdim\pgfmathresult pt>0pt
          \ifx\bnvon\empty\xdef\bnvon{\k}\fi\xdef\bnbis{\k}\fi}%
      \PackageWarning{mathblatt}{binomialverteilung n=#2: zeige k=\bnvon..\bnbis\space (P(X=k)>=0.0005); von/bis setzen fuer anderen Bereich}%
    \fi\fi
  \pgfmathsetmacro{\bnpmax}{0}%
  \foreach \k in {\bnvon,...,\bnbis}{\mbbinp{#2}{#3}{\k}\pgfmathsetmacro{\bnpmax}{max(\bnpmax,\mbbp)}\xdef\bnpmax{\bnpmax}}%
  \ifx\bnystep\empty\pgfmathsetmacro{\bnystep}{ifthenelse(\bnpmax>0.25,0.05,ifthenelse(\bnpmax>0.1,0.02,0.01))}\fi
  \ifx\bnymax\empty\pgfmathsetmacro{\bnymax}{ceil(\bnpmax/\bnystep+0.3)*\bnystep}\fi
  \pgfmathsetmacro{\bnyk}{\bnkaro/\bnystep}%
  \pgfmathsetmacro{\bnxa}{\bnvon-0.5}\pgfmathsetmacro{\bnxb}{\bnbis+0.5}%
  \pgfmathsetmacro{\bnypfeil}{\bnymax+0.6*\bnystep}%
  \pgfmathtruncatemacro{\bnl}{max(1,ceil((\bnbis-\bnvon)/25))}% jede l-te Zahl
  \ifx\bnmark\empty\def\bnma{-1}\def\bnmb{-1}\else\expandafter\mbrzwei\bnmark\relax\let\bnma\mbrtmin\let\bnmb\mbrtmax\fi
  \begin{tikzpicture}[x=\bnkaro cm,y=\bnyk cm,baseline=(current bounding box.north)]
    \draw[mbgitter,line width=0.3pt] (\bnxa,0) grid[xstep=1,ystep=\bnystep] (\bnxb,\bnymax);
    \foreach \k in {\bnvon,...,\bnbis}{\mbbinp{#2}{#3}{\k}%
      \pgfmathparse{(\k>=\bnma)&&(\k<=\bnmb)}\ifdim\pgfmathresult pt>0pt
        \filldraw[fill=mbgrau,line width=0.5pt] (\k-0.3,0) rectangle (\k+0.3,\mbbp);
      \else\filldraw[fill=mbkasten,line width=0.5pt] (\k-0.3,0) rectangle (\k+0.3,\mbbp);\fi
      \pgfmathtruncatemacro{\mbrest}{mod(\k,\bnl)}%
      \ifnum\mbrest=0 \node[below,inner sep=2pt,font=\scriptsize] at (\k,0) {$\k$};\fi}
    \draw[-{Stealth[length=2mm]},line width=0.6pt] (\bnxa,0) -- (\bnxb+0.7,0) node[right] {\small$k$};
    \draw[-{Stealth[length=2mm]},line width=0.6pt] (\bnxa,0) -- (\bnxa,\bnypfeil) node[above right,inner sep=1pt] {\small$P(X=k)$};
    \pgfmathsetmacro{\bnya}{\bnystep}\pgfmathsetmacro{\bnyb}{2*\bnystep}%
    \foreach \y in {\bnya,\bnyb,...,\bnymax}{%
      \draw (\bnxa-0.15,\y) -- (\bnxa+0.15,\y) node[left,inner sep=3pt,font=\scriptsize] {$\pgfmathprintnumber{\y}$};}
  \end{tikzpicture}}

% \normalverteilung[Schlüssel]{mu}{sigma}   Dichtekurve mit x-Achse; Schlüssel: xstep (Voreinstellung
%   sigma), xmin/xmax (mu ± 3.5 sigma), karo (0.8), von=a, bis=b (Fläche schraffiert grau; nur von
%   oder nur bis = einseitig), xlabel. Höhe des Maximums 4 Karos, y-Achse ohne Zahlen.
\pgfkeys{/nv/.is family, /nv,
  xmin/.estore in=\nvxmin, xmax/.estore in=\nvxmax, xstep/.estore in=\nvxstep, karo/.estore in=\nvkaro,
  von/.estore in=\nvvon, bis/.estore in=\nvbis, xlabel/.estore in=\nvxlabel,
  default/.style={xmin=,xmax=,xstep=,karo=0.8,von=,bis=,xlabel=$x$}}
\NewDocumentCommand{\normalverteilung}{O{} m m}{%
  \pgfkeys{/nv,default,#1}%
  \ifx\nvxstep\empty\edef\nvxstep{#3}\fi
  \ifx\nvxmin\empty\pgfmathsetmacro{\nvxmin}{(#2)-3.5*(#3)}\fi
  \ifx\nvxmax\empty\pgfmathsetmacro{\nvxmax}{(#2)+3.5*(#3)}\fi
  \ifx\nvvon\empty\let\nvvon\nvxmin\fi
  \ifx\nvbis\empty\let\nvbis\nvxmax\fi
  \pgfmathsetmacro{\nvxk}{\nvkaro/\nvxstep}%
  \pgfmathsetmacro{\nvyk}{4*\nvkaro}% Maximum der Kurve = 4 Karos
  \pgfmathsetmacro{\nvxpfeil}{\nvxmax+0.4*\nvxstep}%
  \pgfmathsetmacro{\nvga}{ceil(\nvxmin/\nvxstep)*\nvxstep}\pgfmathsetmacro{\nvgb}{\nvga+\nvxstep}%
  \pgfmathsetmacro{\nvgz}{floor(\nvxmax/\nvxstep)*\nvxstep}%
  \begin{tikzpicture}[x=\nvxk cm,y=\nvyk cm,baseline=(current bounding box.north)]
    \draw[mbgitter,line width=0.3pt] (\nvga,0) grid[xstep=\nvxstep,ystep=0.25] (\nvgz,1.25);
    \ifdim\nvvon pt=\nvxmin pt\ifdim\nvbis pt=\nvxmax pt\else
      \fill[mbgrau,fill opacity=0.35,domain=\nvvon:\nvbis,samples=60] plot (\x,{exp(-0.5*((\x-(#2))/(#3))^2)}) -- (\nvbis,0) -- (\nvvon,0) -- cycle;\fi
    \else
      \fill[mbgrau,fill opacity=0.35,domain=\nvvon:\nvbis,samples=60] plot (\x,{exp(-0.5*((\x-(#2))/(#3))^2)}) -- (\nvbis,0) -- (\nvvon,0) -- cycle;\fi
    \draw[line width=0.8pt,domain=\nvxmin:\nvxmax,samples=120,smooth] plot (\x,{exp(-0.5*((\x-(#2))/(#3))^2)});
    \draw[dashed,line width=0.5pt] (#2,0) -- (#2,1);
    \draw[-{Stealth[length=2mm]},line width=0.6pt] (\nvxmin,0) -- (\nvxpfeil,0) node[right] {\small\nvxlabel};
    \foreach \x in {\nvga,\nvgb,...,\nvgz}{\draw (\x,0.03) -- (\x,-0.03) node[below,inner sep=2pt,font=\scriptsize] {$\pgfmathprintnumber{\x}$};}
  \end{tikzpicture}}

% ---------------------------------------------------------------------------
% N  Geometrie Sek I: Vierecke, Netze, Strahlensatz, Winkel am Kreis (Maße in cm)
% ---------------------------------------------------------------------------
% \viereck[Schlüssel]{(0,0)}{(5,0)}{(6,3)}{(1,3)}   Ecken A, B, C, D gegen den Uhrzeigersinn
%   Schlüssel: punkte={A,B,C,D} (Voreinstellung; punkte= ohne Labels), seiten={a,b,c,d},
%   diagonalen (Labels e, f) oder diagonalen={e,f}, hoehe (Lot von D auf AB, Label h) oder hoehe=h,
%   winkel (alpha..delta) oder winkel={\alpha,\beta,,}, achsen=senkrecht|waagerecht|beide|diagonalen|alle
% \parallelogramm[Schlüssel]{a}{b}{alpha}   \trapez[Schlüssel]{a}{c}{h}   \raute[Schlüssel]{e}{f}
% \rechteck[Schlüssel]{a}{b}   \drachen[Schlüssel]{e}{f}{t}  (t = Anteil von e bis zur Querdiagonale, 0..1)
\pgfkeys{/vrk/.is family, /vrk,
  punkte/.estore in=\vrpunkte, seiten/.estore in=\vrseiten,
  diagonalen/.estore in=\vrdiag, diagonalen/.default={e,f},
  hoehe/.estore in=\vrhoehe, hoehe/.default=h,
  winkel/.estore in=\vrwinkel, winkel/.default={\alpha,\beta,\gamma,\delta},
  achsen/.estore in=\vrachsen,
  default/.style={punkte={A,B,C,D},seiten=,diagonalen=,hoehe=,winkel=,achsen=}}
\def\mbvier#1,#2,#3,#4\relax{\def\mbva{#1}\def\mbvb{#2}\def\mbvc{#3}\def\mbvd{#4}}
\def\mbzweik#1,#2\relax{\def\mbva{#1}\def\mbvb{#2}}
% Innenwinkelbogen an Ecke P zwischen Richtungen zu Q (vorher) und R (nachher), Label #4
\newcommand{\mbwinkelbogen}[4]{%
  \pgfmathanglebetweenpoints{\pgfpointanchor{#1}{center}}{\pgfpointanchor{#3}{center}}\let\mbwa\pgfmathresult
  \pgfmathanglebetweenpoints{\pgfpointanchor{#1}{center}}{\pgfpointanchor{#2}{center}}\let\mbwb\pgfmathresult
  \pgfmathsetmacro{\mbwb}{ifthenelse(\mbwb<\mbwa,\mbwb+360,\mbwb)}%
  \pgfmathparse{\mbwb-\mbwa>180}\ifdim\pgfmathresult pt>0pt % immer den kleineren Winkel
    \pgfmathsetmacro{\mbwt}{\mbwb-360}\let\mbwb\mbwa\let\mbwa\mbwt\fi
  \draw[mbgrau,line width=0.5pt] ($(#1)+(\mbwa:0.55)$) arc (\mbwa:\mbwb:0.55);
  \pgfmathsetmacro{\mbwm}{(\mbwa+\mbwb)/2}%
  \mbklabel{#4}{($(#1)+(\mbwm:0.85)$)}{}}
\NewDocumentCommand{\viereck}{O{} m m m m}{%
  \pgfkeys{/vrk,default,#1}%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.8pt]
    \coordinate (A) at #2; \coordinate (B) at #3; \coordinate (C) at #4; \coordinate (D) at #5;
    \ifdefempty{\vrachsen}{}{%
      \coordinate (M) at ($0.25*(A)+0.25*(B)+0.25*(C)+0.25*(D)$);
      \def\mbachse##1##2{\draw[mbgrau,dash pattern=on 4pt off 2pt on 1pt off 2pt,line width=0.5pt] ($(##1)!-0.5cm!(##2)$) -- ($(##2)!-0.5cm!(##1)$);}
      \edef\mbat{\vrachsen}%
      \ifx\mbat\mbsenk\mbachse{M}{$(M)+(0,1)$}\fi
      \ifx\mbat\mbwaag\mbachse{M}{$(M)+(1,0)$}\fi
      \ifx\mbat\mbbeide\mbachse{M}{$(M)+(0,1)$}\mbachse{M}{$(M)+(1,0)$}\fi
      \ifx\mbat\mbdiag\mbachse{A}{C}\mbachse{B}{D}\fi
      \ifx\mbat\mballe\mbachse{M}{$(M)+(0,1)$}\mbachse{M}{$(M)+(1,0)$}\mbachse{A}{C}\mbachse{B}{D}\fi}
    \draw (A) -- (B) -- (C) -- (D) -- cycle;
    \ifdefempty{\vrdiag}{}{\expandafter\mbzweik\vrdiag\relax
      \draw[dashed,line width=0.5pt] (A) -- (C); \mbklabel{\mbva}{($(A)!0.3!(C)$)}{fill=white,inner sep=1pt}
      \draw[dashed,line width=0.5pt] (B) -- (D); \mbklabel{\mbvb}{($(B)!0.3!(D)$)}{fill=white,inner sep=1pt}}
    \ifdefempty{\vrhoehe}{}{%
      \coordinate (F) at ($(A)!(D)!(B)$);
      \draw[dashed,line width=0.5pt] (D) -- (F);
      \draw[line width=0.4pt] ($(F)!0.22cm!(D)$) -- ($(F)!0.22cm!(D)+($(F)!0.22cm!(B)$)-(F)$) -- ($(F)!0.22cm!(B)$);
      \fill ($(F)!0.11cm!(D)+($(F)!0.11cm!(B)$)-(F)$) circle (0.6pt);
      \node[right,font=\small,inner sep=2pt] at ($(D)!0.5!(F)$) {$\vrhoehe$};}
    \ifdefempty{\vrseiten}{}{\expandafter\mbvier\vrseiten\relax
      \path (A) -- (B) node[midway,below,font=\small] {$\mbva$};
      \path (B) -- (C) node[midway,right,font=\small] {$\mbvb$};
      \path (C) -- (D) node[midway,above,font=\small] {$\mbvc$};
      \path (D) -- (A) node[midway,left,font=\small] {$\mbvd$};}
    \ifdefempty{\vrwinkel}{}{\expandafter\mbvier\vrwinkel\relax
      \mbwinkelbogen{A}{D}{B}{\mbva}\mbwinkelbogen{B}{A}{C}{\mbvb}%
      \mbwinkelbogen{C}{B}{D}{\mbvc}\mbwinkelbogen{D}{C}{A}{\mbvd}}
    \ifdefempty{\vrpunkte}{}{\expandafter\mbvier\vrpunkte\relax
      \mbklabel{\mbva}{(A)}{below left}\mbklabel{\mbvb}{(B)}{below right}%
      \mbklabel{\mbvc}{(C)}{above right}\mbklabel{\mbvd}{(D)}{above left}}
  \end{tikzpicture}}
\def\mbsenk{senkrecht}\def\mbwaag{waagerecht}\def\mbbeide{beide}\def\mbdiag{diagonalen}\def\mballe{alle}
\NewDocumentCommand{\parallelogramm}{O{} m m m}{%
  \pgfmathsetmacro{\mbpx}{(#3)*cos(#4)}\pgfmathsetmacro{\mbpy}{(#3)*sin(#4)}%
  \viereck[#1]{(0,0)}{(#2,0)}{({#2+\mbpx},\mbpy)}{(\mbpx,\mbpy)}}
\NewDocumentCommand{\rechteck}{O{} m m}{\viereck[#1]{(0,0)}{(#2,0)}{(#2,#3)}{(0,#3)}}
\NewDocumentCommand{\trapez}{O{} m m m}{% a unten, c oben zentriert, Höhe h
  \pgfmathsetmacro{\mbtx}{((#2)-(#3))/2}%
  \viereck[#1]{(0,0)}{(#2,0)}{({#2-\mbtx},#4)}{(\mbtx,#4)}}
\NewDocumentCommand{\raute}{O{} m m}{% Diagonalen e (waagerecht), f
  \viereck[#1]{(0,{-(#3)/2})}{({(#2)/2},0)}{(0,{(#3)/2})}{({-(#2)/2},0)}}
\NewDocumentCommand{\drachen}{O{} m m m}{% e senkrecht (Symmetrieachse), f quer bei Anteil t von e
  \pgfmathsetmacro{\mbdy}{(#4)*(#2)}%
  \viereck[#1]{(0,0)}{({(#3)/2},\mbdy)}{(0,#2)}{({-(#3)/2},\mbdy)}}

% Netze: \netzquader{a}{b}{c}{a}{b}{c}   Längen in cm, Labels (leer = ohne); Faltkanten dünn
%        \netzwuerfel{a}{a}   \netzpyramide{a}{hs}{a}{h_s}   \netzzylinder{r}{h}{r}{h}
\NewDocumentCommand{\netzquader}{m m m m m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.8pt,falt/.style={line width=0.4pt}]
    % Kreuz: Mitte vorn (a x c), links/rechts (b x c), oben/unten (a x b), hinten rechts (a x c)
    \draw[falt] (#2,0) -- (#2,#3) ({#2+#1},0) -- ({#2+#1},#3) ({#2+#1+#2},0) -- ({#2+#1+#2},#3)
      (#2,#3) -- ({#2+#1},#3) (#2,0) -- ({#2+#1},0);
    \draw (0,0) -- (#2,0) -- (#2,{-#2}) -- ({#2+#1},{-#2}) -- ({#2+#1},0) -- ({#2+#1+#2+#1},0)
      -- ({#2+#1+#2+#1},#3) -- ({#2+#1},#3) -- ({#2+#1},{#3+#2}) -- (#2,{#3+#2}) -- (#2,#3) -- (0,#3) -- cycle;
    \node[below,font=\small] at ({#2+#1/2},{-#2}) {$#4$};
    \node[below,font=\small] at ({#2/2},0) {$#5$};
    \node[left,font=\small] at (0,{#3/2}) {$#6$};
  \end{tikzpicture}}
\newcommand{\netzwuerfel}[2]{\netzquader{#1}{#1}{#1}{#2}{}{}}
\NewDocumentCommand{\netzpyramide}{m m m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.8pt,falt/.style={line width=0.4pt}]
    \pgfmathsetmacro{\mbh}{#1/2}%
    \draw[falt] (-\mbh,-\mbh) rectangle (\mbh,\mbh);
    \draw (-\mbh,-\mbh) -- (0,{-\mbh-#2}) -- (\mbh,-\mbh) -- ({\mbh+#2},0) -- (\mbh,\mbh)
      -- (0,{\mbh+#2}) -- (-\mbh,\mbh) -- ({-\mbh-#2},0) -- cycle;
    \draw[dashed,line width=0.5pt] (0,-\mbh) -- (0,{-\mbh-#2});
    \draw[line width=0.4pt] (0.2,-\mbh) -- (0.2,{-\mbh-0.2}) -- (0,{-\mbh-0.2}); \fill (0.1,{-\mbh-0.1}) circle (0.6pt);
    \node[below,font=\small] at (0,\mbh) {$#3$};
    \node[right,font=\small,inner sep=2pt] at (0,{-\mbh-#2/2}) {$#4$};
  \end{tikzpicture}}
\NewDocumentCommand{\netzzylinder}{m m m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.8pt,falt/.style={line width=0.4pt}]
    \pgfmathsetmacro{\mbu}{2*pi*#1}%
    \draw (0,0) rectangle (\mbu,#2);
    \draw (#1,{#2+#1}) circle (#1); \draw (#1,{-#1}) circle (#1);
    \draw[dashed,line width=0.5pt] (#1,{#2+#1}) -- ({2*#1},{#2+#1});
    \fill (#1,{#2+#1}) circle (1.2pt);
    \node[above,font=\small,inner sep=1.5pt] at ({1.5*#1},{#2+#1}) {$#3$};
    \node[right,font=\small] at (\mbu,{#2/2}) {$#4$};
    \node[below,font=\small,mbgrau] at ({\mbu/2},0) {$u = 2\pi r$};
  \end{tikzpicture}}

% Strahlensatz: \strahlensatz[Schlüssel]{ZA}{ZA'}{Winkel}   V-Figur; [x] für die X-Figur
%   Schlüssel: punkte={Z,A,B,A',B'} (Voreinstellung), strecken={ZA,AA',AB,A'B'} Labels (leer = ohne;
%   bei der X-Figur ZA, ZA', AB, A'B'), faktor=1.3 (ZB = faktor * ZA), x
\pgfkeys{/stz/.is family, /stz,
  punkte/.estore in=\stpunkte, strecken/.estore in=\ststrecken, faktor/.estore in=\stfaktor,
  x/.is if=mbstx,
  default/.style={punkte={Z,A,B,A',B'},strecken=,faktor=1.3}}
\newif\ifmbstx
\def\mbfuenf#1,#2,#3,#4,#5\relax{\def\mbva{#1}\def\mbvb{#2}\def\mbvc{#3}\def\mbvd{#4}\def\mbve{#5}}
\NewDocumentCommand{\strahlensatz}{O{} m m m}{%
  \mbstxfalse\pgfkeys{/stz,default,#1}%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.8pt]
    \coordinate (Z) at (0,0);
    \pgfmathsetmacro{\stza}{#2}\pgfmathsetmacro{\stzb}{#3}%
    \pgfmathsetmacro{\stka}{\stza*\stfaktor}\pgfmathsetmacro{\stkb}{\stzb*\stfaktor}%
    \pgfmathsetmacro{\stl}{\stzb+0.8}\pgfmathsetmacro{\stlb}{\stkb+0.8}%
    \ifmbstx
      \coordinate (A) at (180:\stza); \coordinate (B) at ({180+#4}:\stka);
      \coordinate (Ab) at (0:\stzb); \coordinate (Bb) at (#4:\stkb);
      \draw[line width=0.6pt] (180:{\stza+0.8}) -- (0:\stl);
      \draw[line width=0.6pt] ({180+#4}:{\stka+0.8}) -- (#4:\stlb);
    \else
      \coordinate (A) at (0:\stza); \coordinate (B) at (#4:\stka);
      \coordinate (Ab) at (0:\stzb); \coordinate (Bb) at (#4:\stkb);
      \draw[line width=0.6pt] (Z) -- (0:\stl); \draw[line width=0.6pt] (Z) -- (#4:\stlb);
    \fi
    \draw (A) -- (B); \draw (Ab) -- (Bb);
    \foreach \p in {Z,A,B,Ab,Bb}{\fill (\p) circle (1.4pt);}
    \ifdefempty{\stpunkte}{}{\expandafter\mbfuenf\stpunkte\relax
      \mbklabel{\mbva}{(Z)}{below}%
      \ifmbstx\mbklabel{\mbvb}{(A)}{above}\mbklabel{\mbvc}{(B)}{below left}\else\mbklabel{\mbvb}{(A)}{below}\mbklabel{\mbvc}{(B)}{above left}\fi
      \mbklabel{\mbvd}{(Ab)}{below}\mbklabel{\mbve}{(Bb)}{above left}}
    % Streckenlabels: V-Figur ZA, AA', AB, A'B'; X-Figur ZA, ZA', AB, A'B'
    \ifdefempty{\ststrecken}{}{\expandafter\mbvier\ststrecken\relax
      \mbklabel{\mbva}{($(Z)!0.5!(A)$)}{below,inner sep=3pt}%
      \ifmbstx\mbklabel{\mbvb}{($(Z)!0.5!(Ab)$)}{below,inner sep=3pt}\else\mbklabel{\mbvb}{($(A)!0.5!(Ab)$)}{below,inner sep=3pt}\fi
      \mbklabel{\mbvc}{($(A)!0.5!(B)$)}{fill=white,inner sep=1pt}\mbklabel{\mbvd}{($(Ab)!0.5!(Bb)$)}{fill=white,inner sep=1pt}}
  \end{tikzpicture}}

% Winkel am Kreis (in der Umgebung kreis):
% \mittelpunktswinkel{a}{b}{\mu}     Schenkel M-A, M-B zu den Randpunkten bei a und b Grad, Bogen an M
% \umfangswinkel{a}{b}{c}{\gamma}    Sehnen von C (bei c Grad) nach A und B, Bogen an C;
%                                    bei b - a = 180 (Thales) rechter Winkel markiert
\newcommand{\mittelpunktswinkel}[3]{%
  \draw[line width=0.7pt] (#1:\krr) -- (0,0) -- (#2:\krr);
  \draw[mbgrau,line width=0.5pt] (#1:0.5) arc (#1:#2:0.5);
  \pgfmathsetmacro{\krm}{(#1+#2)/2}\mbklabel{#3}{(\krm:0.8)}{}%
  \fill (0,0) circle (1.4pt);}
\newcommand{\umfangswinkel}[4]{%
  \coordinate (kA) at (#1:\krr); \coordinate (kB) at (#2:\krr); \coordinate (kC) at (#3:\krr);
  \draw[line width=0.7pt] (kA) -- (kC) -- (kB);
  \pgfmathtruncatemacro{\krd}{abs(#2-#1)}%
  \ifnum\krd=180
    \draw[line width=0.4pt] ($(kC)!0.25cm!(kA)$) -- ($(kC)!0.25cm!(kA)+($(kC)!0.25cm!(kB)$)-(kC)$) -- ($(kC)!0.25cm!(kB)$);
    \fill ($(kC)!0.12cm!(kA)+($(kC)!0.12cm!(kB)$)-(kC)$) circle (0.6pt);
    \pgfmathanglebetweenpoints{\pgfpointanchor{kC}{center}}{\pgfpointanchor{kA}{center}}\let\mbwa\pgfmathresult
    \pgfmathanglebetweenpoints{\pgfpointanchor{kC}{center}}{\pgfpointanchor{kB}{center}}\let\mbwb\pgfmathresult
    \pgfmathsetmacro{\mbwb}{ifthenelse(\mbwb<\mbwa,\mbwb+360,\mbwb)}\pgfmathsetmacro{\mbwm}{(\mbwa+\mbwb)/2}%
    \mbklabel{#4}{($(kC)+(\mbwm:0.6)$)}{}%
  \else
    \mbwinkelbogen{kC}{kA}{kB}{#4}%
  \fi
  \fill (kC) circle (1.4pt);}

% ---------------------------------------------------------------------------
% O  Zahlen, Algebra, Trigonometrie
% ---------------------------------------------------------------------------
% \zahlenstrahl[Schlüssel]{Punkte}   Schlüssel: xmin=-5, xmax=5, xstep=1, karo=0.8 (cm je Schritt)
%   Punkte: Wert/Label durch Komma, leeres Label = nur Markierung; \zahlenstrahl{} nur die Gerade.
%   \zahlenstrahl[xmin=0,xmax=2,xstep=0.25]{0.5/\frac12, 1.75/B}
% \intervall{a}{b}{Label}   im Zahlenstrahl: Strecke mit vollen Enden, [a;b]
%   \intervall{a}{b}{}  ;  offene Enden mit  \intervallo{a}{b}{Label}  (beide offen)
%   halboffen: \intervall*{a}{b}{L} (links offen) , \intervallo*{a}{b}{L} (rechts offen)
%   Unbeschränkt: a oder b leer = Pfeil ins Unendliche  \intervall{2}{}{x>=2}
%   Mehrere Intervalle liegen untereinander, wenn sie sich überschneiden: zweites Argument der
%   Umgebung ist die Zeile: \intervall[2]{...}
\pgfkeys{/zst/.is family, /zst,
  xmin/.estore in=\zsxmin, xmax/.estore in=\zsxmax, xstep/.estore in=\zsxstep, karo/.estore in=\zskaro,
  default/.style={xmin=-5,xmax=5,xstep=1,karo=0.8}}
% Stufe 6, drei Reparaturen (Befunde Testlauf Eingabe 3):
%   - Die Striche laufen über eine ganze Zahl von Schritten (0 … n, n = (xmax−xmin)/xstep abgerundet).
%     Bis Stufe 5 zählte \foreach in Dezimalschritten und verfehlte durch Rundung oft den letzten
%     Wert: der Strich bei xmax fehlte, wenn xmax genau auf dem Raster lag.
%   - Gezeichnet wird relativ zu xmin. Bis Stufe 5 lag etwa 7,6 bei xstep 0.01 (80 cm je Einheit)
%     jenseits der größten TeX-Länge (575 cm): „Dimension too large", der Strahl fehlte.
%     Eigenes TikZ in der Umgebung zahlengerade rechnet deshalb ebenso relativ: ({7.7-\zsxmin},0).
%   - Wäre der Strahl breiter als die Zeile, setzt die Vorlage karo so weit herab, dass er passt.
\newenvironment{zahlengerade}[1][]{%
  \pgfkeys{/zst,default,#1}%
  \pgfmathtruncatemacro{\zsn}{floor((\zsxmax-\zsxmin)/\zsxstep+0.01)}%
  \pgfmathsetmacro{\zskaroeff}{min(\zskaro,(\linewidth/28.4528-0.6)/(\zsn+0.8))}%
  \pgfmathsetmacro{\zsk}{\zskaroeff/\zsxstep}%
  \pgfmathsetmacro{\zspfeil}{\zsxmax-\zsxmin+0.5*\zsxstep}%
  \pgfmathsetmacro{\zsl}{-0.3*\zsxstep}%
  \pgfmathtruncatemacro{\zsko}{round(\zsxmin/\zsxstep)}%
  \xdef\mbwmax{0pt}% Ausduennung wie beim ksys
  \foreach \mbzi in {0,...,\zsn}{\pgfmathsetmacro{\mbzv}{\zsxmin+\mbzi*\zsxstep}%
    \sbox\mbmessbox{\scriptsize$\pgfmathprintnumber{\mbzv}$}%
    \ifdim\wd\mbmessbox>\mbwmax\xdef\mbwmax{\the\wd\mbmessbox}\fi}%
  \pgfmathtruncatemacro{\zsxl}{max(1,ceil((\mbwmax+2pt)/(\zskaroeff cm)))}%
  \begin{tikzpicture}[x=\zsk cm,y=1cm,baseline=(current bounding box.north)]
    \draw[-{Stealth[length=2mm]},line width=0.6pt] (\zsl,0) -- (\zspfeil,0);
    \foreach \mbzi in {0,...,\zsn}{%
      \pgfmathsetmacro{\mbzv}{\zsxmin+\mbzi*\zsxstep}%
      \pgfmathsetmacro{\mbzr}{\mbzi*\zsxstep}%
      \pgfmathtruncatemacro{\mbrest}{mod(abs(\zsko+\mbzi),\zsxl)}%
      \draw (\mbzr,0.1) -- (\mbzr,-0.1)
      \ifnum\mbrest=0 node[below,inner sep=2pt,font=\scriptsize] {$\pgfmathprintnumber{\mbzv}$}\fi;}
}{\end{tikzpicture}}
\NewDocumentCommand{\zahlenstrahl}{O{} m}{%
  \begin{zahlengerade}[#1]
    \ifblank{#2}{}{\foreach \v/\l in {#2}{\fill ({\v-\zsxmin},0) circle (1.6pt);
      \ifdefempty{\l}{}{\node[above,inner sep=3pt,font=\small] at ({\v-\zsxmin},0) {$\l$};}}}
  \end{zahlengerade}}
% Intervall in der Umgebung zahlengerade; Ende leer = Pfeil
\newcommand{\mbivende}[3]{% x, offen(0/1), Richtung fuer Pfeil (-1 links, 1 rechts) wenn x leer
  \ifblank{#1}{}{\ifnum#2=1 \filldraw[fill=white,line width=0.8pt] ({(#1)-\zsxmin},\mbivy) circle (2pt);
    \else\fill ({(#1)-\zsxmin},\mbivy) circle (2pt);\fi}}
\NewDocumentCommand{\intervall}{s O{1} m m m}{\mbintervall{#2}{#3}{#4}{#5}{\IfBooleanTF{#1}{1}{0}}{0}}
\NewDocumentCommand{\intervallo}{s O{1} m m m}{\mbintervall{#2}{#3}{#4}{#5}{1}{\IfBooleanTF{#1}{0}{1}}}
\newcommand{\mbintervall}[6]{% Zeile, a, b, Label, links offen, rechts offen
  \pgfmathsetmacro{\mbivy}{0.65*#1}%
  \ifblank{#2}{\def\mbiva{\zsl}}{\pgfmathsetmacro{\mbiva}{(#2)-\zsxmin}}%
  \ifblank{#3}{\def\mbivb{\zspfeil}}{\pgfmathsetmacro{\mbivb}{(#3)-\zsxmin}}%
  \ifblank{#2}{\def\mbivl{Stealth}}{\def\mbivl{}}\ifblank{#3}{\def\mbivr{Stealth}}{\def\mbivr{}}%
  \edef\mbivarr{\mbivl-\mbivr}%
  \draw[line width=1.6pt,arrows/.expanded=\mbivarr,>={Stealth[length=2.5mm]}] (\mbiva,\mbivy) -- (\mbivb,\mbivy);
  \mbivende{#2}{#5}{-1}\mbivende{#3}{#6}{1}%
  \ifblank{#4}{}{\node[above,inner sep=2pt,font=\small] at ({(\mbiva+\mbivb)/2},\mbivy) {$#4$};}}

% Bruchteile: \bruchkreis{3}{8}   3 von 8 Teilen gefuellt (Radius 1 cm; [r] fuer anderen)
%             \bruchrechteck{3}{8}   Streifen 4 cm x 1 cm in 8 Felder, 3 gefuellt
%             \bruchkreis{0}{8}, \bruchrechteck{0}{8}  nur die Teilung
\NewDocumentCommand{\bruchkreis}{O{1} m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.6pt]
    \pgfmathsetmacro{\mbw}{360/#3}%
    \ifnum#2>0 \fill[mbgrau,fill opacity=0.45] (0,0) -- (90:#1) arc (90:{90-#2*\mbw}:#1) -- cycle;\fi
    \foreach \i in {1,...,#3}{\draw (0,0) -- ({90-\i*\mbw}:#1);}
    \draw (0,0) circle (#1);
  \end{tikzpicture}}
\NewDocumentCommand{\bruchrechteck}{O{4} m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.6pt]
    \pgfmathsetmacro{\mbw}{#1/#3}%
    \ifnum#2>0 \fill[mbgrau,fill opacity=0.45] (0,0) rectangle ({#2*\mbw},1);\fi
    \foreach \i in {1,...,#3}{\draw ({\i*\mbw},0) -- ({\i*\mbw},1);}
    \draw (0,0) rectangle (#1,1);
  \end{tikzpicture}}

% Termbaum: \termbaum{Wurzel}{Kind}{Kind}   Kinder sind Text (Blatt) oder \tb{Knoten}{Kind}{Kind}:
%   \termbaum{+}{3x}{\tb{\cdot}{2}{y}}     Leerer Knoten {} = Feld zum Eintragen. Alles im Mathemodus.
%   Der Baum wird vor dem Zeichnen zu einem TikZ-Pfad expandiert (\tb ist expandierbar).
\newcommand{\mbtbknoten}[1]{\ifblank{#1}{\underline{\hspace{5mm}}}{$#1$}}
\def\mbfirst#1#2\mbend{#1}
\def\tb#1#2#3{node[tbk]{\noexpand\mbtbknoten{#1}} child{\mbtbc{#2}} child{\mbtbc{#3}}}
\def\mbtbc#1{\expandafter\ifx\mbfirst#1\mbguard\mbend\tb #1\else node[tbk]{\noexpand\mbtbknoten{#1}}\fi}
\NewDocumentCommand{\termbaum}{m m m}{%
  \protected@edef\mbtree{\tb{#1}{#2}{#3}}%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.6pt,
     tbk/.style={font=\small,inner sep=2pt,minimum size=5mm},
     level distance=9mm, level 1/.style={sibling distance=30mm},
     level 2/.style={sibling distance=15mm}, level 3/.style={sibling distance=8mm}]
    \path \mbtree;
  \end{tikzpicture}}

% Einheitskreis: \einheitskreis{50}   Winkel in Grad; sin als senkrechte, cos als waagerechte Strecke
%   \einheitskreis[karo=1.5]{50}   Radius in cm (Voreinstellung 2); [ohne]{50} nur Punkt und Radius
\pgfkeys{/ehk/.is family, /ehk, karo/.estore in=\ehr, ohne/.is if=mbehohne,
  default/.style={karo=2,ohne=false}}
\newif\ifmbehohne
\NewDocumentCommand{\einheitskreis}{O{} m}{%
  \mbehohnefalse\pgfkeys{/ehk,default,#1}%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.6pt]
    \pgfmathsetmacro{\ehp}{\ehr+0.45}\pgfmathsetmacro{\ehm}{-\ehr-0.3}%
    \draw[mbgitter,line width=0.3pt] (-\ehr,-\ehr) grid[step=0.5*\ehr] (\ehr,\ehr);
    \draw[-{Stealth[length=2mm]}] (\ehm,0) -- (\ehp,0) node[right] {\small$x$};
    \draw[-{Stealth[length=2mm]}] (0,\ehm) -- (0,\ehp) node[above] {\small$y$};
    \foreach \v/\t in {1/1,-1/-1}{\draw ({\v*\ehr},0.08) -- ({\v*\ehr},-0.08) node[below,font=\scriptsize] {$\t$};
      \draw (0.08,{\v*\ehr}) -- (-0.08,{\v*\ehr}) node[left,font=\scriptsize] {$\t$};}
    \draw[line width=0.8pt] (0,0) circle (\ehr);
    \pgfmathsetmacro{\ehx}{\ehr*cos(#2)}\pgfmathsetmacro{\ehy}{\ehr*sin(#2)}%
    \ifmbehohne\else
      \draw[line width=1pt] (\ehx,0) -- (\ehx,\ehy) node[midway,right,font=\small,fill=white,inner sep=1pt] {$\sin\alpha$};
      \draw[line width=1pt] (0,0) -- (\ehx,0) node[midway,below,font=\small,fill=white,inner sep=1pt] {$\cos\alpha$};
    \fi
    \draw[line width=0.8pt] (0,0) -- (\ehx,\ehy);
    \draw[mbgrau,line width=0.5pt] (0.5,0) arc (0:#2:0.5);
    \pgfmathsetmacro{\ehw}{#2/2}\node[font=\small] at (\ehw:0.75) {$\alpha$};
    \fill (\ehx,\ehy) circle (1.6pt) node[above right,font=\small] {$P$};
  \end{tikzpicture}}

% Trigonometrische Kurven im ksys: x-Achse in Vielfachen von pi beschriftet.
% \begin{ksys}[trigo]  = xmin=-pi/2..2*pi, xstep=pi/2 (Karo 1 cm = pi/2), ymin=-2, ymax=2;
%   die x-Zahlen werden als Vielfache von pi gesetzt (-pi/2, pi/2, pi, 3pi/2, 2pi).
%   \sinus{2}{1}{f}    a*sin(b*x) ; \kosinus{1}{1}{g}
%   Nullstellen, Hoch- und Tiefpunkte mit \punkt, \hochpunkt, \tiefpunkt (x in Bogenmass: pi/2 = 1.5708)
\pgfkeys{/ksys, trigo/.style={xmin=-1.5708,xmax=6.2832,xstep=1.5708,ymin=-2,ymax=2,karo=1.0,pizahlen}}
\newif\ifmbpizahlen
\pgfkeys{/ksys, pizahlen/.is if=mbpizahlen}
\NewDocumentCommand{\sinus}{m m m}{\funktion{(#1)*sin(deg((#2)*\x))}{#3}}
\NewDocumentCommand{\kosinus}{m m m}{\funktion{(#1)*cos(deg((#2)*\x))}{#3}}

% ---------------------------------------------------------------------------
% P  Prozentrechnung: Streifen und Dreisatz
% ---------------------------------------------------------------------------
% Streifen-Familie: alle Bausteine stellen 100 % als 10-cm-Rechteck dar und teilen sich den Rahmen
% \mbstreifenrahmen{Breite}{Höhe}{Teilstriche} (nur den Umriss mit Teilstrichen, kein Inhalt).
%   \mbstreifenrahmen{Breite}{Höhe}{Teilstriche}    durchgehende, graue Teilstriche (Lineal zum Ablesen)
%   \mbstreifenrahmen*{Breite}{Höhe}{Teilstriche}   nur kurze Eckstriche (unter gefüllten Flächen)
\NewDocumentCommand{\mbstreifenrahmen}{s m m m}{%
  \draw[line width=0.7pt] (0,0) rectangle (#2,#3);
  \pgfmathtruncatemacro{\mbstn}{#4}%
  \ifnum\mbstn>1
    \pgfmathtruncatemacro{\mbstm}{\mbstn-1}%
    \foreach \mbsti in {1,...,\mbstm}{\pgfmathsetmacro{\mbstx}{\mbsti/\mbstn*(#2)}%
      \IfBooleanTF{#1}
        {\draw[line width=0.4pt] (\mbstx,0) -- (\mbstx,0.18) (\mbstx,#3) -- (\mbstx,{(#3)-0.18});}
        {\draw[black!50,line width=0.4pt] (\mbstx,0) -- (\mbstx,#3);}}%
  \fi}

% \streifenleer                     leerer Streifen 10 x 1,2 cm, 0 %/50 %/100 % beschriftet (Schüler trägt ein)
% \streifenleer[4]                  mit 4 statt 10 Teilen (kurze Eckstriche wie bisher)
% \streifenleer[0]                  ohne Teilstriche, nur 0 % und 100 % beschriftet: der Schüler teilt
%                                   selbst ein (Stufe 6; Befund Testlauf Eingabe 3 Nr. 12)
% \streifenvoll{Rad/40,Bus/25,...}  Streifen komplett gefüllt: Abschnitte nach Prozentwert (müssen sich zu
%   100 summieren), Label im Abschnitt in wechselnden Grautönen, leeres Label {} lässt es weg
\newcommand{\streifenleer}[1][10]{%
  \begin{tikzpicture}[baseline=(current bounding box.north)]
    \mbstreifenrahmen*{10}{1.2}{#1}
    \node[below,font=\small] at (0,0) {$0\,\%$};
    \ifnum#1>0 \node[below,font=\small] at (5,0) {$50\,\%$};\fi
    \node[below,font=\small] at (10,0) {$100\,\%$};
  \end{tikzpicture}}
\NewDocumentCommand{\streifenvoll}{m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north)]
    \xdef\mbsta{0}%
    \foreach \l/\w [count=\i] in {#1}{%
      \edef\mbstb{\fpeval{round(\mbsta+\w/10,3)}}%
      \pgfmathsetmacro{\mbstg}{100-14*mod(\i-1,4)-4}%
      \fill[black!\fpeval{round(100-\mbstg)}] (\mbsta,0) rectangle (\mbstb,1.2);
      \draw[line width=0.5pt] (\mbstb,0) -- (\mbstb,1.2);
      \ifblank{\l}{}{\node[font=\small] at ({(\mbsta+\mbstb)/2},0.6) {\l};}%
      \xdef\mbsta{\mbstb}}%
    \mbstreifenrahmen*{10}{1.2}{10}
  \end{tikzpicture}}

% \streifen[Teilstriche]{Füllung in %}{Label links unten}{Label rechts unten}   ein Abschnitt 0..Füllung
% \streifenfrage[Teilstriche]{Füllung}{links}{rechts}    wie \streifen, mit „?“ über der Füllgrenze
%   (Teilstriche Voreinstellung 10; Streifen 10 x 0,8 cm; Füllung in Prozent, auch als Dezimalzahl)
%   \streifen[0]{0}{$0\,\%$}{$100\,\%$}   Streifen ohne Teilstriche zum Einteilen durch den Schüler
%   (0 oder 1 lässt die Teilstriche weg; so seit Stufe 4, in Stufe 6 nur dokumentiert)
\newcommand{\streifen}[4][10]{%
  \par\smallskip\noindent
  \begin{tikzpicture}[baseline=0pt]
    \pgfmathsetmacro{\sfill}{(#2)/100*10}%
    \ifdim\sfill pt>0pt\fill[black!20] (0,0) rectangle (\sfill,0.8);\fi
    \mbstreifenrahmen{10}{0.8}{#1}
    \node[below,font=\small] at (0,-0.05) {#3};
    \node[below,font=\small] at (10,-0.05) {#4};
  \end{tikzpicture}
  \par\smallskip}
\newcommand{\streifenfrage}[4][10]{%
  \par\smallskip\noindent
  \begin{tikzpicture}[baseline=0pt]
    \pgfmathsetmacro{\sfill}{(#2)/100*10}%
    \ifdim\sfill pt>0pt\fill[black!20] (0,0) rectangle (\sfill,0.8);\fi
    \mbstreifenrahmen{10}{0.8}{#1}
    \draw[line width=1pt] (\sfill,-0.1) -- (\sfill,0.9);
    \node[above,font=\small] at (\sfill,0.9) {?};
    \node[below,font=\small] at (0,-0.05) {#3};
    \node[below,font=\small] at (10,-0.05) {#4};
  \end{tikzpicture}
  \par\smallskip}

% \streifenfeld[Teilstriche]{Füllung in %}{Label links unten}{Label rechts unten}
%   wie \streifen, rechts daneben ein leeres Feld für den abgelesenen Prozentsatz
%   (\leerfeld[\%]); für Aufgaben „lies am Streifen ab und trage ein".
%   \streifenfeld[4]{75}{$0\,\%$}{$100\,\%$}
\newcommand{\streifenfeld}[4][10]{%
  \par\smallskip\noindent
  \begin{tikzpicture}[baseline=0pt]
    \pgfmathsetmacro{\sfill}{(#2)/100*10}%
    \ifdim\sfill pt>0pt\fill[black!20] (0,0) rectangle (\sfill,0.8);\fi
    \mbstreifenrahmen{10}{0.8}{#1}
    \node[below,font=\small] at (0,-0.05) {#3};
    \node[below,font=\small] at (10,-0.05) {#4};
  \end{tikzpicture}\quad\leerfeld[\%]%
  \par\smallskip}

% \streifenreihe[Teilstriche]{Buchstabe/Füllung, ...}   mehrere Streifen a), b), ... untereinander,
%   je 100 % (9,5 x 0,62 cm je Zeile)
\newcommand{\streifenreihe}[2][10]{%
  \par\smallskip\noindent
  \begin{tikzpicture}[baseline=0pt]
    \foreach \lab/\ff [count=\r from 0] in {#2}{%
      \pgfmathsetmacro{\yy}{-\r*1.04}%
      \pgfmathsetmacro{\sfill}{\ff/100*9.5}%
      \begin{scope}[yshift=\yy cm]
        \ifdim\sfill pt>0pt\fill[black!20] (0,0) rectangle (\sfill,0.62);\fi
        \mbstreifenrahmen{9.5}{0.62}{#1}
        \node[left,font=\small] at (-0.15,0.31) {\lab)};
        \node[right,font=\scriptsize] at (9.65,0.31) {100\,\%};
      \end{scope}}
  \end{tikzpicture}
  \par\smallskip}
% \streifenwertreihe[Teilstriche]{Buchstabe/Füllung/Teilwert/Ganzwert, ...}   wie \streifenreihe, mit
%   Markierung an der Füllgrenze und den Werten 0, Teilwert, Ganzwert darunter (9 x 0,62 cm je Zeile);
%   ein Wert leer bleibt als Feld zum Eintragen (Prozentwert bzw. Grundwert berechnen), \dsleer ebenso
%   Stufe 6: Bis Stufe 5 stand bei leerem Teil- oder Ganzwert gar nichts; jetzt steht dort das Feld
%   \mbstreifenwertfeld (Schreiblinie 1,2 cm).
\newcommand{\mbstreifenwertfeld}{\rule[-0.4ex]{1.2cm}{0.4pt}}
\newcommand{\mbstreifenwert}[1]{\expandafter\ifblank\expandafter{#1}{\mbstreifenwertfeld}{#1}}
\newcommand{\streifenwertreihe}[2][10]{%
  \par\smallskip\noindent
  \begin{tikzpicture}[baseline=0pt]
    \foreach \lab/\ff/\tw/\gw [count=\r from 0] in {#2}{%
      \pgfmathsetmacro{\yy}{-\r*1.34}%
      \pgfmathsetmacro{\sfill}{\ff/100*9}%
      \begin{scope}[yshift=\yy cm]
        \ifdim\sfill pt>0pt\fill[black!20] (0,0) rectangle (\sfill,0.62);\fi
        \mbstreifenrahmen{9}{0.62}{#1}
        \draw[line width=1pt] (\sfill,-0.08) -- (\sfill,0.62);
        \node[left,font=\small] at (-0.15,0.31) {\lab)};
        \node[below,font=\scriptsize] at (0,-0.05) {0};
        \node[below,font=\scriptsize] at (\sfill,-0.05) {\mbstreifenwert{\tw}};
        \node[below,font=\scriptsize] at (9,-0.05) {\mbstreifenwert{\gw}};
      \end{scope}}
  \end{tikzpicture}
  \par\smallskip}

% Dreisatz-Schema: zwei beschriftete Spalten, Werte mit \dsz, Rechenschritt mit Pfeilen mit \dsp
% (Zeilenende jeweils intern, kein \\ nötig), fehlender Wert mit \dsleer.
%   \begin{dreisatz}{Hefte}{Preis}
%   \dsz{4}{6{,}00\,€}  \dsp{:4}{:4}  \dsz{1}{1{,}50\,€}  \dsp{\cdot 6}{\cdot 6}  \dsz{6}{9{,}00\,€}
%   \end{dreisatz}
\newcommand{\dsleer}{\rule[-0.5ex]{1.5cm}{0.4pt}}
\newenvironment{dreisatz}[2]{%
  \par\smallskip\noindent
  \renewcommand{\arraystretch}{1.05}%
  \begin{tabular}{@{}r@{\,}c@{\hspace{7mm}}c@{\,}l@{}}
  \multicolumn{1}{c}{} & \textbf{#1} & \textbf{#2} & \multicolumn{1}{c}{}\\[0.4ex]
}{%
  \end{tabular}\par\smallskip}
\newcommand{\dsz}[2]{ & #1 & #2 & \\}
\newcommand{\dsp}[2]{ {\footnotesize$#1$}$\big\downarrow$ & & & $\big\downarrow${\footnotesize$#2$} \\}

% ---------------------------------------------------------------------------
% Q  Option „schwach" (ziel.md § 2 im Repo mathe-nachhilfe)
% ---------------------------------------------------------------------------
% Die Option ändert die Form, nicht den Stoff: zwei bis drei Aufgaben je Seite, neben jeder
% Teilaufgabe die Darstellung (Streifen, Tabelle, Skizze), aus der der Rechenweg entsteht, und
% statt einer Antwortlinie ein Raster mit einer Schreibzeile je Schritt.
% Alle vier Bausteine setzen links die Teilaufgabe, rechts die Darstellung.
% \swz und \swa zählen mit dem teil-Zähler der Vorlage (Buchstabe a), b), …), \swb nicht:
% es ist das vorgerechnete Beispiel.
\newcommand{\mbswlinks}{0.34}   % Anteil der Textbreite links (Teilaufgabe)
\newcommand{\mbswrechts}{0.62}  % Anteil der Textbreite rechts (Darstellung)
\newcommand{\mbswpaar}[2]{\par\noindent
  \begin{minipage}[t]{\mbswlinks\linewidth}\vspace{0pt}\raggedright #1\end{minipage}\hfill
  \begin{minipage}[t]{\mbswrechts\linewidth}\vspace{2pt}#2\end{minipage}\par\addvspace{3mm}}
% \swz[Schreibzeilen]{Teilaufgabe}{Darstellung}   Rechenteilaufgabe mit Raster (Vorgabe 2 Zeilen)
%   \swz{Der Streifen sind 20\,€, gefärbt sind 6\,€.}{\streifen{30}{$0\,€$}{$20\,€$}}
\newcommand{\swz}[3][2]{\mbswpaar{\stepcounter{teil}\mbtzkopf{\alph{teil})}#2\schreibzeilen{#1}}{#3}}
% \swa{Teilaufgabe}{Darstellung}   Ablese- oder Zeichenteilaufgabe, ohne Raster
%   \swa{in 25-\%-Schritte}{\streifen[0]{0}{$0\,\%$}{$100\,\%$}}
\newcommand{\swa}[2]{\mbswpaar{\begin{teile}\teil #1\end{teile}}{#2}}
% \swb{Beispiel}{Darstellung}   durchgerechnetes Beispiel vor dem Päckchen, ohne Buchstabe
%   \swb{\beispiel{20 \text{ von } 100 &= \tfrac{20}{100} \\ &= 20\,\%}}{\streifenfrage{20}{$0$}{$100$}}
\newcommand{\swb}[2]{\mbswpaar{#1}{#2}}
% \swfrage{Was bleibt gleich, was ändert sich?}   Erklärzeile über die ganze Breite mit zwei
%   Schreibzeilen; zählt als Teilaufgabe.
\newcommand{\swfrage}[1]{\par\nopagebreak\noindent
  \stepcounter{teil}\mbtzkopf{\alph{teil})}#1\schreibzeilen{2}\par\addvspace{3mm}}

