%   Leere Zelle zum Eintragen: \leerzelle (Schreiblinie ohne Gleichheitszeichen).
\newcommand{\leerzelle}{\rule[-0.5ex]{1.4cm}{0.4pt}}
\ExplSyntaxOn
\NewDocumentCommand{\sachtabelle}{m m m}{
  \par\medskip\noindent
  \group_begin:
  \dim_set:Nn \tabcolsep {7pt} \renewcommand{\arraystretch}{1.25}
