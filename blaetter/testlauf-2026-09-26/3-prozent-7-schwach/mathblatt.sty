\NewDocumentCommand{\kugel}{m m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.7pt]
    \draw (0,0) circle (#1);
    \draw[line width=0.5pt] (-#1,0) arc (180:360:{#1} and {#1*0.35});
