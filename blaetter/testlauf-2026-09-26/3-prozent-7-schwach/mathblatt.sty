%                      \einheitenkopf[e2]{...} – optionales Sprungziel, Sternform gleich
%                      \verzeichniszeile{\verz{e1}{...} \verztrenn \verz{e2}{...}} – klickbare Zeile
%                        am Blattanfang; hyperref lädt die Vorlage selbst, wenn das Blatt es nicht tut
%                      Umgebung abhakseite mit \abhakgruppe und \abhak – Seite „Das kann ich";
%                        \abhakauto sammelt die Titel der \aufgabe-Köpfe über \jobname.abh
%                      gleichungsraster: Tiefe unter der letzten Schreibzeile (\mbschreibtiefe),
%                        der Aufruf braucht keinen Zusatzabstand mehr
%                      \streifenfeld – Streifen mit Antwortfeld daneben (Blatt prozentrechnung 24.09.)
%                      Option „schwach": \swz, \swa, \swb, \swfrage – Teilaufgabe mit Raster links,
%                        Darstellung rechts (Abschnitt Q, ziel.md § 2))
% Version 2026-09-22h (Beschriftung bei \balkenab und \liniendia: \balkenab misst die Kategorienamen
%                      links an der Achse und den Achsentitel rechts, hält den Platz frei und kürzt
%                      die Balken, damit die Grafik im Satzspiegel bleibt; \liniendia rückt die Punkte
