% Strichliste: das Makro zeichnet die Liste in Fünferbündeln – vier senkrechte Striche, der
% fünfte quer darüber, zwischen den Bündeln eine Lücke.
%   \strichliste{13}           Anzahl als Zahl (Normalfall)
%   \strichliste{|||||\ |||}   alte Schreibweise der abgelegten Blätter: besteht das Argument nur
%                              aus Strichen und Abständen, zählt das Makro die Striche selbst.
\newcommand{\mbstrichbild}[1]{%
  \pgfmathtruncatemacro{\mbstrb}{int((#1)/5)}%
  \pgfmathtruncatemacro{\mbstrr}{(#1)-5*\mbstrb}%
  \pgfmathtruncatemacro{\mbstrrm}{\mbstrr-1}%
  \begin{tikzpicture}[x=1mm,y=1mm,line width=0.6pt,baseline=0pt]
    \ifnum\mbstrb>0
      \foreach \b in {1,...,\mbstrb}{%
        \pgfmathsetmacro{\mbstrx}{(\b-1)*6.8}%
        \foreach \s in {0,...,3}{\draw (\mbstrx+\s*1.4,0) -- (\mbstrx+\s*1.4,3.6);}%
        \draw (\mbstrx-0.7,0.5) -- (\mbstrx+4.9,3.1);}%
    \fi
    \ifnum\mbstrr>0
      \pgfmathsetmacro{\mbstrq}{\mbstrb*6.8}%
      \foreach \s in {0,...,\mbstrrm}{\draw (\mbstrq+\s*1.4,0) -- (\mbstrq+\s*1.4,3.6);}%
    \fi
    \ifnum\mbstrb=0 \ifnum\mbstrr=0 \path (0,0) rectangle (0.1,3.6);\fi\fi
  \end{tikzpicture}}
\ExplSyntaxOn
\NewDocumentCommand{\strichliste}{m}{
  \regex_count:nnN { \| } {#1} \l_tmpa_int
  \int_compare:nNnTF { \l_tmpa_int } > { 0 }
    { \exp_args:Nx \mbstrichbild { \int_use:N \l_tmpa_int } }
    { \exp_args:Nx \mbstrichbild { \int_eval:n {#1} } } }
\ExplSyntaxOff

% \kreisdiagramm*[r]{Label/Wert, ...}   wie \kreisdiagramm, aber statt der Labels führt aus jedem
%   Sektor eine Linie nach außen auf einen Schreibstrich – für Zuordnungs- und Beschriftungsaufgaben.
\NewDocumentCommand{\kreisdiagrammleer}{O{1.8} m}{%
  \begin{tikzpicture}[baseline=(current bounding box.north),line width=0.6pt]
    \pgfmathsetmacro{\mbsum}{0}%
    \foreach \l/\w in {#2}{\pgfmathsetmacro{\mbsum}{\mbsum+\w}\xdef\mbsum{\mbsum}}%
    \xdef\mbwa{90}%
    \foreach \l/\w [count=\i] in {#2}{%
      \edef\mbwb{\fpeval{round(\mbwa-360*\w/\mbsum,3)}}%
      \pgfmathsetmacro{\mbg}{0.96-0.14*mod(\i-1,4)}%
      \filldraw[fill=black!\fpeval{round((1-\mbg)*100)}] (0,0) -- (\mbwa:#1) arc (\mbwa:\mbwb:#1) -- cycle;
      \pgfmathsetmacro{\mbwm}{(\mbwa+\mbwb)/2}%
      \pgfmathtruncatemacro{\mbrechts}{(cos(\mbwm)>=0)}%
      \draw[line width=0.4pt] (\mbwm:{#1*0.75}) -- (\mbwm:{#1+0.45});
      \ifnum\mbrechts=1
        \draw[line width=0.4pt] (\mbwm:{#1+0.45}) -- ++(1.5,0);
      \else
        \draw[line width=0.4pt] (\mbwm:{#1+0.45}) -- ++(-1.5,0);
      \fi
      \xdef\mbwa{\mbwb}}%
    \draw (0,0) circle (#1);
  \end{tikzpicture}}

% Leerer Kreis mit Mittelpunkt M und einem Radius nach oben (12-Uhr-Stellung) als Nullmarke zum
% Antragen eigener Sektoren mit dem Geodreieck – Vorstufe zu \kreisdiagramm für Aufgaben, in denen
